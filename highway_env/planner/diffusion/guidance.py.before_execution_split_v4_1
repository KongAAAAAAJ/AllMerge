from __future__ import annotations

from dataclasses import dataclass
from typing import Mapping, Optional, Tuple

import torch
import torch.nn.functional as F


@dataclass(frozen=True)
class SparseCurvatureGuidanceConfig:
    """Runtime-only sparse-trajectory curvature guidance.

    The guidance configuration is deliberately kept outside
    ``StructuredDiffusionConfig`` so pretrained checkpoints remain fully
    compatible and one checkpoint can be evaluated with guidance ON/OFF.
    """

    enabled: bool = False
    guidance_type: str = "sparse_curvature"
    scale: float = 0.05
    curvature_limit: float = 0.02
    grad_clip_norm: float = 1.0
    preserve_endpoint: bool = True
    apply_timesteps: Optional[Tuple[int, ...]] = None
    min_segment_length_m: float = 1.0e-3
    dense_min_speed_mps: float = 0.5  # legacy V1; ignored by dense V2
    dense_step_m: float = 0.20
    dense_topk_fraction: float = 0.20
    dense_min_segment_m: float = 0.25
    # DENSE_CURVATURE_GUIDANCE_V3
    dense_inner_iters: int = 5
    dense_backtracking_enabled: bool = True
    dense_backtracking_factor: float = 0.5
    dense_backtracking_max_trials: int = 4
    dense_min_step_m: float = 0.025
    dense_max_total_move_m: float = 0.50
    dense_bound_weight: float = 1.0
    dense_peak_weight: float = 0.5
    dense_dkappa_weight: float = 0.1
    dense_peak_alpha: float = 10.0
    dense_residual_gradient_enabled: bool = True
    dense_normal_projection_enabled: bool = True
    # DENSE_GUIDANCE_G2_ADAPTIVE_NORMAL_V3_3
    # Disabled by default: F' + G1.1 remains exactly reproducible.
    dense_adaptive_normal_enabled: bool = False
    dense_adaptive_normal_medium_curvature: float = 0.04
    dense_adaptive_normal_hard_curvature: float = 0.10
    dense_adaptive_normal_medium_tangent_weight: float = 0.20
    dense_adaptive_normal_hard_tangent_weight: float = 0.50
    # DENSE_GUIDANCE_G1_POLISHING_V3_2
    # Disabled by default so F' / Full V3.1 remains bit-for-bit the baseline.
    dense_polish_enabled: bool = False
    dense_polish_max_curvature: float = 0.04
    dense_polish_iters: int = 3
    dense_polish_step_m: float = 0.075
    # DENSE_GUIDANCE_FSHARP_POST_RECOVERY_V3_4
    # Post-baseline normal-only recovery for final hard-tail modes.
    dense_post_recovery_enabled: bool = False
    dense_post_recovery_threshold: float = 0.04
    dense_post_recovery_iters: int = 3
    dense_post_recovery_step_m: float = 0.10
    dense_post_recovery_max_total_move_m: float = 0.50

    # DENSE_GUIDANCE_CASCADE_RECOVERY_V3_5
    # Strategy applies only after the complete F' + G1.x baseline.
    # normal: C1/F#; adaptive_tangent: G2.2; adaptive_trust: G3.
    dense_post_recovery_strategy: str = "normal"
    dense_post_recovery_hard_curvature: float = 0.10
    dense_post_recovery_medium_tangent_weight: float = 0.30
    dense_post_recovery_hard_tangent_weight: float = 0.70
    dense_post_recovery_medium_max_total_move_m: float = 0.75
    dense_post_recovery_hard_max_total_move_m: float = 1.00
    dense_post_recovery_second_polish_enabled: bool = False
    dense_post_recovery_second_polish_iters: int = 8
    dense_post_recovery_second_polish_step_m: float = 0.10
    # DENSE_GUIDANCE_PEAK_RECOVERY_V3_6
    # Final post-cascade recovery for the few remaining max-curvature hard tails.
    dense_peak_recovery_enabled: bool = False
    dense_peak_recovery_threshold: float = 0.04
    dense_peak_recovery_iters: int = 5
    dense_peak_recovery_step_m: float = 0.05
    dense_peak_recovery_bound_weight: float = 0.50
    dense_peak_recovery_peak_weight: float = 2.00
    dense_peak_recovery_dkappa_weight: float = 0.05
    dense_peak_recovery_peak_alpha: float = 20.0
    dense_peak_recovery_min_peak_improvement: float = 1.0e-6
    # EXECUTION_CONSTRAINED_GUIDANCE_V4_0
    # Final constraint stage applied after the complete 73% B0 cascade.
    # Modes: none (B0), alm (A), projection (B), hybrid (C).
    dense_constraint_recovery_mode: str = "none"
    dense_constraint_recovery_threshold: float = 0.02
    dense_constraint_recovery_max_total_move_m: float = 0.50
    dense_constraint_recovery_min_improvement: float = 1.0e-7
    # A: execution-aware augmented-Lagrangian guidance.
    dense_alm_iters: int = 8
    dense_alm_step_m: float = 0.10
    dense_alm_rho: float = 10.0
    dense_alm_dual_step: float = 10.0
    dense_alm_lambda_max: float = 100.0
    dense_alm_active_margin: float = 0.005
    dense_alm_proximity_weight: float = 0.02
    # B: sequential active-set projection onto the linearized worst constraint.
    dense_projection_iters: int = 8
    dense_projection_max_step_m: float = 0.15
    dense_projection_tightening: float = 0.0
    dense_projection_safety_factor: float = 1.05
    eps: float = 1.0e-6

    @classmethod
    def from_mapping(
        cls,
        value: Optional[Mapping[str, object]],
    ) -> "SparseCurvatureGuidanceConfig":
        data = dict(value or {})
        # DENSE_CURVATURE_GUIDANCE_V1: public runtime key is `type`.
        if "type" in data and "guidance_type" not in data:
            data["guidance_type"] = data.pop("type")
        if "guidance_type" in data:
            aliases = {
                "sparse": "sparse_curvature",
                "dense": "dense_curvature",
                "off": "none",
                "disabled": "none",
            }
            key = str(data["guidance_type"]).strip().lower()
            data["guidance_type"] = aliases.get(key, key)
        if "apply_timesteps" in data and data["apply_timesteps"] is not None:
            raw = data["apply_timesteps"]
            if isinstance(raw, str):
                text = raw.strip().lower()
                if text in {"", "all", "none"}:
                    data["apply_timesteps"] = None
                else:
                    data["apply_timesteps"] = tuple(
                        int(item.strip())
                        for item in raw.split(",")
                        if item.strip()
                    )
            else:
                data["apply_timesteps"] = tuple(int(item) for item in raw)
        cfg = cls(**data)
        cfg.validate()
        return cfg

    def validate(self) -> None:
        if self.guidance_type not in {
            "none",
            "sparse_curvature",
            "dense_curvature",
        }:
            raise ValueError(
                "guidance_type must be one of: none, sparse_curvature, "
                f"dense_curvature; got {self.guidance_type!r}"
            )
        if self.scale < 0.0:
            raise ValueError("guidance scale must be >= 0")
        if self.curvature_limit <= 0.0:
            raise ValueError("guidance curvature_limit must be positive")
        if self.grad_clip_norm <= 0.0:
            raise ValueError("guidance grad_clip_norm must be positive")
        if self.min_segment_length_m <= 0.0:
            raise ValueError("guidance min_segment_length_m must be positive")
        if self.dense_min_speed_mps < 0.0:
            raise ValueError("legacy dense_min_speed_mps must be >= 0")
        if self.dense_step_m < 0.0:
            raise ValueError("guidance dense_step_m must be >= 0")
        if not (0.0 < self.dense_topk_fraction <= 1.0):
            raise ValueError("guidance dense_topk_fraction must be in (0, 1]")
        if self.dense_min_segment_m <= 0.0:
            raise ValueError("guidance dense_min_segment_m must be positive")
        if self.dense_inner_iters < 1:
            raise ValueError("guidance dense_inner_iters must be >= 1")
        if not (0.0 < self.dense_backtracking_factor < 1.0):
            raise ValueError("guidance dense_backtracking_factor must be in (0,1)")
        if self.dense_backtracking_max_trials < 1:
            raise ValueError("guidance dense_backtracking_max_trials must be >= 1")
        if self.dense_min_step_m <= 0.0:
            raise ValueError("guidance dense_min_step_m must be positive")
        if self.dense_max_total_move_m <= 0.0:
            raise ValueError("guidance dense_max_total_move_m must be positive")
        if min(self.dense_bound_weight, self.dense_peak_weight, self.dense_dkappa_weight) < 0.0:
            raise ValueError("dense V3 loss weights must be >= 0")
        if self.dense_peak_alpha <= 0.0:
            raise ValueError("guidance dense_peak_alpha must be positive")
        # DENSE_GUIDANCE_G2_ADAPTIVE_NORMAL_V3_3
        if self.dense_adaptive_normal_medium_curvature <= self.curvature_limit:
            raise ValueError(
                "dense_adaptive_normal_medium_curvature must exceed curvature_limit"
            )
        if self.dense_adaptive_normal_hard_curvature <= self.dense_adaptive_normal_medium_curvature:
            raise ValueError(
                "dense_adaptive_normal_hard_curvature must exceed the medium threshold"
            )
        if not (0.0 <= self.dense_adaptive_normal_medium_tangent_weight <= 1.0):
            raise ValueError(
                "dense_adaptive_normal_medium_tangent_weight must be in [0,1]"
            )
        if not (0.0 <= self.dense_adaptive_normal_hard_tangent_weight <= 1.0):
            raise ValueError(
                "dense_adaptive_normal_hard_tangent_weight must be in [0,1]"
            )
        if (
            self.dense_adaptive_normal_hard_tangent_weight
            < self.dense_adaptive_normal_medium_tangent_weight
        ):
            raise ValueError(
                "hard tangent weight must be >= medium tangent weight"
            )
        # DENSE_GUIDANCE_G1_POLISHING_V3_2
        if self.dense_polish_max_curvature <= self.curvature_limit:
            raise ValueError(
                "dense_polish_max_curvature must be greater than curvature_limit"
            )
        if self.dense_polish_iters < 1:
            raise ValueError("guidance dense_polish_iters must be >= 1")
        if self.dense_polish_step_m <= 0.0:
            raise ValueError("guidance dense_polish_step_m must be positive")
        # DENSE_GUIDANCE_CASCADE_RECOVERY_V3_5
        if self.dense_post_recovery_strategy not in {
            "normal", "adaptive_tangent", "adaptive_trust"
        }:
            raise ValueError(
                "dense_post_recovery_strategy must be one of: "
                "normal, adaptive_tangent, adaptive_trust"
            )
        if self.dense_post_recovery_hard_curvature <= self.dense_post_recovery_threshold:
            raise ValueError(
                "dense_post_recovery_hard_curvature must exceed post-recovery threshold"
            )
        if not (0.0 <= self.dense_post_recovery_medium_tangent_weight <= 1.0):
            raise ValueError("post-recovery medium tangent weight must be in [0,1]")
        if not (0.0 <= self.dense_post_recovery_hard_tangent_weight <= 1.0):
            raise ValueError("post-recovery hard tangent weight must be in [0,1]")
        if (
            self.dense_post_recovery_hard_tangent_weight
            < self.dense_post_recovery_medium_tangent_weight
        ):
            raise ValueError("post-recovery hard tangent weight must be >= medium")
        if self.dense_post_recovery_medium_max_total_move_m <= 0.0:
            raise ValueError("post-recovery medium trust region must be positive")
        if self.dense_post_recovery_hard_max_total_move_m <= 0.0:
            raise ValueError("post-recovery hard trust region must be positive")
        if (
            self.dense_post_recovery_hard_max_total_move_m
            < self.dense_post_recovery_medium_max_total_move_m
        ):
            raise ValueError("post-recovery hard trust region must be >= medium")
        if self.dense_post_recovery_second_polish_iters < 1:
            raise ValueError("post-recovery second polish iters must be >= 1")
        if self.dense_post_recovery_second_polish_step_m <= 0.0:
            raise ValueError("post-recovery second polish step must be positive")
        # DENSE_GUIDANCE_PEAK_RECOVERY_V3_6
        if self.dense_peak_recovery_threshold <= self.curvature_limit:
            raise ValueError("peak-recovery threshold must exceed curvature_limit")
        if self.dense_peak_recovery_iters < 1:
            raise ValueError("peak-recovery iters must be >= 1")
        if self.dense_peak_recovery_step_m <= 0.0:
            raise ValueError("peak-recovery step must be positive")
        if min(
            self.dense_peak_recovery_bound_weight,
            self.dense_peak_recovery_peak_weight,
            self.dense_peak_recovery_dkappa_weight,
        ) < 0.0:
            raise ValueError("peak-recovery loss weights must be >= 0")
        if self.dense_peak_recovery_peak_weight <= 0.0:
            raise ValueError("peak-recovery peak weight must be positive")
        if self.dense_peak_recovery_peak_alpha <= 0.0:
            raise ValueError("peak-recovery peak alpha must be positive")
        if self.dense_peak_recovery_min_peak_improvement < 0.0:
            raise ValueError("peak-recovery minimum peak improvement must be >= 0")
        # EXECUTION_CONSTRAINED_GUIDANCE_V4_0
        if self.dense_constraint_recovery_mode not in {"none", "alm", "projection", "hybrid"}:
            raise ValueError("dense_constraint_recovery_mode must be none/alm/projection/hybrid")
        if self.dense_constraint_recovery_threshold < self.curvature_limit:
            raise ValueError("constraint recovery threshold must be >= curvature_limit")
        if self.dense_constraint_recovery_max_total_move_m <= 0.0:
            raise ValueError("constraint recovery trust region must be positive")
        if self.dense_constraint_recovery_min_improvement < 0.0:
            raise ValueError("constraint recovery minimum improvement must be >= 0")
        if self.dense_alm_iters < 1 or self.dense_projection_iters < 1:
            raise ValueError("ALM/projection iterations must be >= 1")
        if self.dense_alm_step_m <= 0.0 or self.dense_projection_max_step_m <= 0.0:
            raise ValueError("ALM/projection step sizes must be positive")
        if self.dense_alm_rho <= 0.0 or self.dense_alm_dual_step <= 0.0:
            raise ValueError("ALM rho/dual step must be positive")
        if self.dense_alm_lambda_max <= 0.0:
            raise ValueError("ALM lambda max must be positive")
        if self.dense_alm_active_margin < 0.0 or self.dense_alm_proximity_weight < 0.0:
            raise ValueError("ALM active margin/proximity weight must be >= 0")
        if self.dense_projection_tightening < 0.0:
            raise ValueError("projection tightening must be >= 0")
        if self.dense_projection_tightening >= self.curvature_limit:
            raise ValueError("projection tightening must be < curvature_limit")
        if self.dense_projection_safety_factor <= 0.0:
            raise ValueError("projection safety factor must be positive")
        if self.eps <= 0.0:
            raise ValueError("guidance eps must be positive")
        if self.apply_timesteps is not None:
            if any(int(t) < 0 for t in self.apply_timesteps):
                raise ValueError("guidance apply_timesteps must be >= 0")

    def applies_to(self, timestep: int) -> bool:
        if not self.enabled or self.guidance_type == "none":
            return False
        if self.guidance_type == "dense_curvature":
            if self.dense_step_m <= 0.0:
                return False
        elif self.scale <= 0.0:
            return False
        if self.apply_timesteps is None:
            return True
        return int(timestep) in self.apply_timesteps


def sparse_discrete_curvature(
    trajectory_xy_m: torch.Tensor,
    *,
    min_segment_length_m: float = 1.0e-3,
    eps: float = 1.0e-6,
) -> tuple[torch.Tensor, torch.Tensor]:
    """Three-point geometric curvature for an ego-centric sparse trajectory.

    ``trajectory_xy_m`` is [..., H, 2] in physical metres.  The ego origin
    [0, 0] is prepended, therefore an H-waypoint trajectory yields H-1
    curvature samples.  The formula is the signed circumcircle curvature:

        kappa = 2 * cross(a, b) / (|a| |b| |a+b|)

    Degenerate triplets are marked invalid instead of producing large
    numerical curvature spikes.
    """
    if trajectory_xy_m.ndim < 2 or trajectory_xy_m.shape[-1] != 2:
        raise ValueError(
            "trajectory_xy_m must end with [H,2], got "
            f"{tuple(trajectory_xy_m.shape)}"
        )
    if trajectory_xy_m.shape[-2] < 2:
        raise ValueError("at least two future waypoints are required")

    origin = torch.zeros_like(trajectory_xy_m[..., :1, :])
    points = torch.cat([origin, trajectory_xy_m], dim=-2)

    edge_prev = points[..., 1:-1, :] - points[..., :-2, :]
    edge_next = points[..., 2:, :] - points[..., 1:-1, :]
    chord = points[..., 2:, :] - points[..., :-2, :]

    cross = (
        edge_prev[..., 0] * edge_next[..., 1]
        - edge_prev[..., 1] * edge_next[..., 0]
    )
    len_prev = torch.linalg.vector_norm(edge_prev, dim=-1)
    len_next = torch.linalg.vector_norm(edge_next, dim=-1)
    len_chord = torch.linalg.vector_norm(chord, dim=-1)

    valid = (
        (len_prev > float(min_segment_length_m))
        & (len_next > float(min_segment_length_m))
        & (len_chord > float(min_segment_length_m))
    )
    denom = len_prev * len_next * len_chord
    curvature = torch.where(
        valid,
        2.0 * cross / denom.clamp_min(float(eps)),
        torch.zeros_like(cross),
    )
    return curvature, valid


def _loss_per_mode(
    trajectory_xy_m: torch.Tensor,
    *,
    curvature_limit: float,
    min_segment_length_m: float,
    eps: float,
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    curvature, valid = sparse_discrete_curvature(
        trajectory_xy_m,
        min_segment_length_m=min_segment_length_m,
        eps=eps,
    )
    # Dimensionless excess makes the guidance scale less sensitive to the
    # chosen physical curvature threshold while retaining the same hinge.
    excess_ratio = F.relu(
        curvature.abs() / float(curvature_limit) - 1.0
    )
    valid_f = valid.to(dtype=trajectory_xy_m.dtype)
    count = valid_f.sum(dim=-1).clamp_min(1.0)
    loss = (excess_ratio.square() * valid_f).sum(dim=-1) / count
    return loss, curvature, valid


def sparse_curvature_statistics(
    trajectory_xy_m: torch.Tensor,
    *,
    curvature_limit: float,
    min_segment_length_m: float = 1.0e-3,
    eps: float = 1.0e-6,
) -> dict[str, torch.Tensor]:
    """Return per-trajectory max |kappa| and threshold violation ratio."""
    curvature, valid = sparse_discrete_curvature(
        trajectory_xy_m,
        min_segment_length_m=min_segment_length_m,
        eps=eps,
    )
    abs_curvature = curvature.abs()
    valid_f = valid.to(dtype=trajectory_xy_m.dtype)
    count = valid_f.sum(dim=-1).clamp_min(1.0)
    max_abs = torch.where(
        valid,
        abs_curvature,
        torch.zeros_like(abs_curvature),
    ).amax(dim=-1)
    violation = (
        (abs_curvature > float(curvature_limit)) & valid
    ).to(dtype=trajectory_xy_m.dtype)
    violation_ratio = violation.sum(dim=-1) / count
    return {
        "max_abs_curvature": max_abs,
        "violation_ratio": violation_ratio,
    }


def apply_sparse_curvature_guidance(
    predicted_x0_norm: torch.Tensor,
    *,
    trajectory_scale: torch.Tensor,
    mode_valid_mask: torch.Tensor,
    config: SparseCurvatureGuidanceConfig,
    timestep: int,
) -> tuple[torch.Tensor, Optional[dict[str, torch.Tensor]]]:
    """Apply one inference-time gradient guidance step to clean x0.

    The denoiser output is detached first.  A tiny local autograd graph is
    created only for physical trajectory coordinates, so model parameters do
    not receive gradients even when the outer inference path is under
    ``torch.no_grad()``.
    """
    if (
        not config.applies_to(int(timestep))
        or config.guidance_type != "sparse_curvature"
    ):
        return predicted_x0_norm, None
    if predicted_x0_norm.ndim != 4 or predicted_x0_norm.shape[-1] != 2:
        raise ValueError(
            "predicted_x0_norm must be [B,M,H,2], got "
            f"{tuple(predicted_x0_norm.shape)}"
        )
    if tuple(mode_valid_mask.shape) != tuple(predicted_x0_norm.shape[:2]):
        raise ValueError(
            "mode_valid_mask shape mismatch: "
            f"mask={tuple(mode_valid_mask.shape)} "
            f"x0={tuple(predicted_x0_norm.shape)}"
        )

    scale_xy = trajectory_scale.to(
        device=predicted_x0_norm.device,
        dtype=predicted_x0_norm.dtype,
    )
    with torch.enable_grad():
        physical_xy = (
            predicted_x0_norm.detach() * scale_xy
        ).requires_grad_(True)
        loss_per_mode, curvature_before, valid_triplet = _loss_per_mode(
            physical_xy,
            curvature_limit=config.curvature_limit,
            min_segment_length_m=config.min_segment_length_m,
            eps=config.eps,
        )
        valid_mode_f = mode_valid_mask.to(dtype=physical_xy.dtype)
        objective = (loss_per_mode * valid_mode_f).sum()
        gradient = torch.autograd.grad(
            objective,
            physical_xy,
            create_graph=False,
            retain_graph=False,
            allow_unused=False,
        )[0]

        # Invalid modes never participate in guidance.
        gradient = gradient * valid_mode_f[..., None, None]

        if config.preserve_endpoint:
            endpoint_mask = torch.ones_like(gradient)
            endpoint_mask[..., -1, :] = 0.0
            gradient = gradient * endpoint_mask

        flat = gradient.flatten(start_dim=-2)
        grad_norm = torch.linalg.vector_norm(flat, dim=-1)
        clip_factor = (
            float(config.grad_clip_norm)
            / grad_norm.clamp_min(float(config.eps))
        ).clamp(max=1.0)
        gradient = gradient * clip_factor[..., None, None]

        guided_xy = physical_xy - float(config.scale) * gradient
        guided_xy = guided_xy.detach()

    with torch.no_grad():
        loss_after, curvature_after, _ = _loss_per_mode(
            guided_xy,
            curvature_limit=config.curvature_limit,
            min_segment_length_m=config.min_segment_length_m,
            eps=config.eps,
        )
        valid_mode_f = mode_valid_mask.to(dtype=guided_xy.dtype)
        mode_count = valid_mode_f.sum(dim=-1).clamp_min(1.0)

        update_per_mode = torch.linalg.vector_norm(
            (guided_xy - physical_xy.detach()).flatten(start_dim=-2),
            dim=-1,
        )
        loss_before_sample = (
            loss_per_mode.detach() * valid_mode_f
        ).sum(dim=-1) / mode_count
        loss_after_sample = (
            loss_after * valid_mode_f
        ).sum(dim=-1) / mode_count
        update_l2_sample = (
            update_per_mode * valid_mode_f
        ).sum(dim=-1) / mode_count

        # Max curvature over all valid modes/triplets for diagnostics.
        valid_all = valid_triplet & mode_valid_mask[..., None]
        max_before = torch.where(
            valid_all,
            curvature_before.detach().abs(),
            torch.zeros_like(curvature_before),
        ).flatten(start_dim=1).amax(dim=-1)
        max_after = torch.where(
            valid_all,
            curvature_after.abs(),
            torch.zeros_like(curvature_after),
        ).flatten(start_dim=1).amax(dim=-1)

        guided_norm = guided_xy / scale_xy
        diagnostics = {
            "loss_before": loss_before_sample,
            "loss_after": loss_after_sample,
            "max_abs_curvature_before": max_before,
            "max_abs_curvature_after": max_after,
            "update_l2_m": update_l2_sample,
        }
    return guided_norm, diagnostics


# DENSE_CURVATURE_GUIDANCE_V1
# DENSE_CURVATURE_GUIDANCE_V2
# Dense curvature is geometry-based: three consecutive 10 Hz spline positions
# are used instead of time derivatives, avoiding near-zero-speed singularities.
def _dense_spline_geometry(
    trajectory_xy_m: torch.Tensor,
    *,
    trajectory_spline,
    start_velocity_xy: torch.Tensor,
) -> tuple[torch.Tensor, torch.Tensor]:
    if trajectory_xy_m.ndim not in (3, 4) or trajectory_xy_m.shape[-1] != 2:
        raise ValueError(
            "trajectory_xy_m must be [B,H,2] or [B,M,H,2], got "
            f"{tuple(trajectory_xy_m.shape)}"
        )
    start_xy = torch.zeros_like(trajectory_xy_m[..., 0, :])
    start_velocity = torch.as_tensor(
        start_velocity_xy,
        device=trajectory_xy_m.device,
        dtype=trajectory_xy_m.dtype,
    )
    while start_velocity.ndim < trajectory_xy_m.ndim - 1:
        start_velocity = start_velocity.unsqueeze(-2)
    dense_time = trajectory_spline.dense_time_s.to(
        device=trajectory_xy_m.device,
        dtype=trajectory_xy_m.dtype,
    )
    position, _, _ = trajectory_spline.evaluate(
        trajectory_xy_m,
        start_xy=start_xy,
        start_velocity_xy=start_velocity,
        query_time_s=dense_time,
    )
    return position, dense_time


def dense_spline_geometric_curvature(
    trajectory_xy_m: torch.Tensor,
    *,
    trajectory_spline,
    start_velocity_xy: torch.Tensor,
    min_segment_m: float = 0.25,
    eps: float = 1.0e-6,
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
    """Three-point geometric curvature on differentiable 10 Hz spline points.

    Returns curvature, valid mask, center xy and center time. The signed
    circumcircle formula is independent of the time-parametric speed:

        kappa = 2 * cross(e_prev, e_next) /
                (|e_prev| |e_next| |p_next-p_prev|)
    """
    position, dense_time = _dense_spline_geometry(
        trajectory_xy_m,
        trajectory_spline=trajectory_spline,
        start_velocity_xy=start_velocity_xy,
    )
    if position.shape[-2] < 3:
        raise ValueError("dense spline must contain at least three positions")

    edge_prev = position[..., 1:-1, :] - position[..., :-2, :]
    edge_next = position[..., 2:, :] - position[..., 1:-1, :]
    chord = position[..., 2:, :] - position[..., :-2, :]
    len_prev = torch.linalg.vector_norm(edge_prev, dim=-1)
    len_next = torch.linalg.vector_norm(edge_next, dim=-1)
    len_chord = torch.linalg.vector_norm(chord, dim=-1)
    valid = (
        (len_prev >= float(min_segment_m))
        & (len_next >= float(min_segment_m))
        & (len_chord >= float(min_segment_m))
    )

    cross = (
        edge_prev[..., 0] * edge_next[..., 1]
        - edge_prev[..., 1] * edge_next[..., 0]
    )
    denominator = len_prev * len_next * len_chord
    raw = 2.0 * cross / denominator.clamp_min(float(eps))
    curvature = torch.where(valid, raw, torch.zeros_like(raw))
    return curvature, valid, position[..., 1:-1, :], dense_time[1:-1]


def dense_spline_curvature(
    trajectory_xy_m: torch.Tensor,
    *,
    trajectory_spline,
    start_velocity_xy: torch.Tensor,
    min_speed_mps: float = 0.5,
    min_segment_m: float = 0.25,
    eps: float = 1.0e-6,
) -> tuple[torch.Tensor, torch.Tensor]:
    """Backward-compatible API; min_speed_mps is ignored by dense V2."""
    del min_speed_mps
    curvature, valid, _, _ = dense_spline_geometric_curvature(
        trajectory_xy_m,
        trajectory_spline=trajectory_spline,
        start_velocity_xy=start_velocity_xy,
        min_segment_m=min_segment_m,
        eps=eps,
    )
    return curvature, valid


def _dense_loss_per_mode(
    trajectory_xy_m: torch.Tensor,
    *,
    trajectory_spline,
    start_velocity_xy: torch.Tensor,
    curvature_limit: float,
    topk_fraction: float = 0.20,
    min_segment_m: float,
    eps: float,
    bound_weight: float = 1.0,
    peak_weight: float = 0.5,
    dkappa_weight: float = 0.1,
    peak_alpha: float = 10.0,
) -> tuple[
    torch.Tensor,
    torch.Tensor,
    torch.Tensor,
    dict[str, torch.Tensor],
]:
    """Dense V3 composite curvature objective.

    ``topk_fraction`` remains in the signature only for V2 checkpoint/runtime
    compatibility; V3 deliberately uses every curvature violation plus a
    smooth peak term and a signed curvature-variation term.
    """
    del topk_fraction
    curvature, valid, _, _ = dense_spline_geometric_curvature(
        trajectory_xy_m,
        trajectory_spline=trajectory_spline,
        start_velocity_xy=start_velocity_xy,
        min_segment_m=min_segment_m,
        eps=eps,
    )
    dtype = trajectory_xy_m.dtype
    valid_f = valid.to(dtype=dtype)
    valid_count = valid_f.sum(dim=-1).clamp_min(1.0)

    excess = F.relu(curvature.abs() / float(curvature_limit) - 1.0)
    excess_sq = excess.square() * valid_f
    bound_loss = excess_sq.sum(dim=-1) / valid_count

    # Smooth maximum of squared violation. Subtract log(N)/alpha so a fully
    # feasible trajectory has exactly zero peak loss.
    alpha = float(peak_alpha)
    neg_inf = torch.full_like(excess_sq, -torch.inf)
    peak_scores = torch.where(valid, alpha * excess_sq, neg_inf)
    peak_lse = torch.logsumexp(peak_scores, dim=-1)
    peak_loss = (
        peak_lse - torch.log(valid_count.clamp_min(1.0))
    ) / alpha
    has_valid = valid.any(dim=-1)
    peak_loss = torch.where(
        has_valid,
        peak_loss.clamp_min(0.0),
        torch.zeros_like(peak_loss),
    )

    pair_valid = valid[..., 1:] & valid[..., :-1]
    pair_f = pair_valid.to(dtype=dtype)
    pair_count = pair_f.sum(dim=-1).clamp_min(1.0)
    delta_kappa = (
        curvature[..., 1:] - curvature[..., :-1]
    ) / float(curvature_limit)
    dkappa_loss = (delta_kappa.square() * pair_f).sum(dim=-1) / pair_count

    # Do not reshape already-feasible modes solely for smoothness.
    has_violation = (excess > 0.0).any(dim=-1)
    dkappa_loss = dkappa_loss * has_violation.to(dtype=dtype)

    total = (
        float(bound_weight) * bound_loss
        + float(peak_weight) * peak_loss
        + float(dkappa_weight) * dkappa_loss
    )
    total = torch.where(has_valid, total, torch.zeros_like(total))
    components = {
        "bound_loss": bound_loss,
        "peak_loss": peak_loss,
        "dkappa_loss": dkappa_loss,
        "has_violation": has_violation,
    }
    return total, curvature, valid, components

def dense_spline_curvature_statistics(
    trajectory_xy_m: torch.Tensor,
    *,
    trajectory_spline,
    start_velocity_xy: torch.Tensor,
    curvature_limit: float,
    min_speed_mps: float = 0.5,
    min_segment_m: float = 0.25,
    eps: float = 1.0e-6,
) -> dict[str, torch.Tensor]:
    """Geometry-based dense curvature statistics plus maximum location."""
    del min_speed_mps
    curvature, valid, center_xy, center_time_s = dense_spline_geometric_curvature(
        trajectory_xy_m,
        trajectory_spline=trajectory_spline,
        start_velocity_xy=start_velocity_xy,
        min_segment_m=min_segment_m,
        eps=eps,
    )
    abs_curvature = curvature.abs()
    valid_f = valid.to(dtype=trajectory_xy_m.dtype)
    count = valid_f.sum(dim=-1).clamp_min(1.0)
    masked_abs = torch.where(
        valid,
        abs_curvature,
        torch.full_like(abs_curvature, -1.0),
    )
    peak_index = masked_abs.argmax(dim=-1)
    has_valid = valid.any(dim=-1)
    max_abs = torch.gather(
        abs_curvature, -1, peak_index.unsqueeze(-1)
    ).squeeze(-1)
    max_abs = torch.where(has_valid, max_abs, torch.zeros_like(max_abs))

    gather_xy = peak_index[..., None, None].expand(*peak_index.shape, 1, 2)
    peak_xy = torch.gather(center_xy, -2, gather_xy).squeeze(-2)
    peak_xy = torch.where(has_valid[..., None], peak_xy, torch.zeros_like(peak_xy))
    peak_time = center_time_s[peak_index]
    peak_time = torch.where(has_valid, peak_time, torch.zeros_like(peak_time))

    violation = (
        (abs_curvature > float(curvature_limit)) & valid
    ).to(dtype=trajectory_xy_m.dtype)
    return {
        "max_abs_curvature": max_abs,
        "violation_ratio": violation.sum(dim=-1) / count,
        "peak_index": peak_index,
        "peak_time_s": peak_time,
        "peak_x_m": peak_xy[..., 0],
        "peak_y_m": peak_xy[..., 1],
    }


def _project_gradient_to_sparse_normals(
    gradient: torch.Tensor,
    trajectory_xy_m: torch.Tensor,
    *,
    eps: float,
) -> torch.Tensor:
    """Project waypoint gradient onto the local path normal direction."""
    horizon = int(trajectory_xy_m.shape[-2])
    if horizon <= 1:
        return gradient
    tangent = torch.zeros_like(trajectory_xy_m)
    origin = torch.zeros_like(trajectory_xy_m[..., 0, :])
    tangent[..., 0, :] = trajectory_xy_m[..., 1, :] - origin
    if horizon > 2:
        tangent[..., 1:-1, :] = (
            trajectory_xy_m[..., 2:, :] - trajectory_xy_m[..., :-2, :]
        )
    tangent[..., -1, :] = (
        trajectory_xy_m[..., -1, :] - trajectory_xy_m[..., -2, :]
    )
    tangent_norm = torch.linalg.vector_norm(tangent, dim=-1, keepdim=True)
    tangent_unit = tangent / tangent_norm.clamp_min(float(eps))
    normal = torch.stack(
        (-tangent_unit[..., 1], tangent_unit[..., 0]),
        dim=-1,
    )
    projected = (gradient * normal).sum(dim=-1, keepdim=True) * normal
    usable = tangent_norm > float(eps)
    return torch.where(usable, projected, gradient)


def _blend_gradient_with_sparse_tangent(
    gradient: torch.Tensor,
    trajectory_xy_m: torch.Tensor,
    tangent_weight: torch.Tensor,
    *,
    eps: float,
) -> torch.Tensor:
    """Normal gradient plus severity-dependent tangent component.

    ``tangent_weight`` is [B,M].  Weight 0 exactly recovers normal-only
    projection; weight 1 recovers the full local tangent+normal gradient.
    """
    horizon = int(trajectory_xy_m.shape[-2])
    if horizon <= 1:
        return gradient
    tangent = torch.zeros_like(trajectory_xy_m)
    origin = torch.zeros_like(trajectory_xy_m[..., 0, :])
    tangent[..., 0, :] = trajectory_xy_m[..., 1, :] - origin
    if horizon > 2:
        tangent[..., 1:-1, :] = (
            trajectory_xy_m[..., 2:, :] - trajectory_xy_m[..., :-2, :]
        )
    tangent[..., -1, :] = (
        trajectory_xy_m[..., -1, :] - trajectory_xy_m[..., -2, :]
    )
    tangent_norm = torch.linalg.vector_norm(tangent, dim=-1, keepdim=True)
    tangent_unit = tangent / tangent_norm.clamp_min(float(eps))
    normal = torch.stack(
        (-tangent_unit[..., 1], tangent_unit[..., 0]),
        dim=-1,
    )
    normal_component = (
        gradient * normal
    ).sum(dim=-1, keepdim=True) * normal
    tangent_component = (
        gradient * tangent_unit
    ).sum(dim=-1, keepdim=True) * tangent_unit
    blended = (
        normal_component
        + tangent_weight[..., None, None] * tangent_component
    )
    usable = tangent_norm > float(eps)
    return torch.where(usable, blended, gradient)


# EXECUTION_CONSTRAINED_GUIDANCE_V4_0
# These final-stage routines operate on the complete B0 output.  They use the
# same differentiable execution -> spline -> curvature mapping as F', but
# replace fixed-weight penalty descent with explicit constrained optimization.
def _constraint_max_state(evaluate_fn, physical_xy: torch.Tensor):
    _, curvature, valid, _ = evaluate_fn(
        physical_xy,
        allow_input_gradient=False,
    )
    abs_curvature = torch.where(
        valid,
        curvature.abs(),
        torch.zeros_like(curvature),
    )
    return abs_curvature.amax(dim=-1), curvature, valid


def _apply_stage_trust_region(
    candidate: torch.Tensor,
    anchor_xy: torch.Tensor,
    trust_m: float,
    *,
    eps: float,
) -> torch.Tensor:
    delta = candidate - anchor_xy
    norm = torch.linalg.vector_norm(delta.flatten(start_dim=-2), dim=-1)
    scale = (float(trust_m) / norm.clamp_min(float(eps))).clamp(max=1.0)
    return anchor_xy + delta * scale[..., None, None]


def _run_execution_alm_recovery(
    current_xy: torch.Tensor,
    *,
    anchor_xy: torch.Tensor,
    mode_valid: torch.Tensor,
    config: SparseCurvatureGuidanceConfig,
    evaluate_fn,
):
    dtype = current_xy.dtype
    device = current_xy.device
    with torch.no_grad():
        start_max, start_curvature, start_valid = _constraint_max_state(
            evaluate_fn, current_xy
        )
    trigger = mode_valid & (
        start_max > float(config.dense_constraint_recovery_threshold) + 1.0e-8
    )
    dual = torch.zeros_like(start_curvature)
    accepted_count = torch.zeros(trigger.shape, device=device, dtype=dtype)
    backtracking = torch.zeros_like(accepted_count)

    for _ in range(int(config.dense_alm_iters)):
        with torch.enable_grad():
            x_var = current_xy.detach().requires_grad_(True)
            _, curvature, valid, _ = evaluate_fn(
                x_var,
                allow_input_gradient=bool(config.dense_residual_gradient_enabled),
            )
            abs_curvature = curvature.abs()
            g = abs_curvature - float(config.curvature_limit)
            active_point = valid & (
                abs_curvature
                >= float(config.curvature_limit)
                - float(config.dense_alm_active_margin)
            )
            lag_term = dual.detach() * g
            penalty = 0.5 * float(config.dense_alm_rho) * torch.relu(g).square()
            constraint_obj = torch.where(
                active_point,
                lag_term + penalty,
                torch.zeros_like(g),
            ).sum(dim=-1)
            proximity = 0.5 * float(config.dense_alm_proximity_weight) * (
                (x_var - anchor_xy).square().sum(dim=(-1, -2))
            )
            max_now = torch.where(
                valid, abs_curvature, torch.zeros_like(abs_curvature)
            ).amax(dim=-1)
            active_mode = trigger & (
                max_now > float(config.curvature_limit) + 1.0e-8
            )
            objective = ((constraint_obj + proximity) * active_mode.to(dtype)).sum()
            if not objective.requires_grad:
                break
            gradient = torch.autograd.grad(objective, x_var)[0]
            gradient = gradient * active_mode[..., None, None].to(dtype)
            # Unlike F'/G3, the constrained stage intentionally keeps the full
            # Jacobian direction.  Minimum displacement and the trust region
            # control longitudinal changes instead of hard normal projection.
            if config.preserve_endpoint:
                gradient = gradient.clone()
                gradient[..., -1, :] = 0.0
            grad_norm = torch.linalg.vector_norm(
                gradient.flatten(start_dim=-2), dim=-1
            )
            direction = gradient / grad_norm.clamp_min(float(config.eps))[..., None, None]
            active_mode = active_mode & (grad_norm > float(config.eps))
            old_violation = torch.where(
                valid,
                torch.relu(g).square(),
                torch.zeros_like(g),
            ).sum(dim=-1).detach()
            old_max = max_now.detach()

        if not bool(active_mode.any().item()):
            break

        accepted = torch.zeros_like(active_mode)
        step = torch.full_like(old_max, float(config.dense_alm_step_m))
        max_trials = (
            int(config.dense_backtracking_max_trials)
            if config.dense_backtracking_enabled else 1
        )
        for trial in range(max_trials):
            trial_active = active_mode & ~accepted
            if not bool(trial_active.any().item()):
                break
            candidate = current_xy - step[..., None, None] * direction.detach()
            candidate = _apply_stage_trust_region(
                candidate,
                anchor_xy,
                float(config.dense_constraint_recovery_max_total_move_m),
                eps=config.eps,
            )
            if config.preserve_endpoint:
                candidate = candidate.clone()
                candidate[..., -1, :] = anchor_xy[..., -1, :]
            with torch.no_grad():
                _, cand_curv, cand_valid, _ = evaluate_fn(
                    candidate, allow_input_gradient=False
                )
                cand_abs = cand_curv.abs()
                cand_g = cand_abs - float(config.curvature_limit)
                cand_max = torch.where(
                    cand_valid, cand_abs, torch.zeros_like(cand_abs)
                ).amax(dim=-1)
                cand_violation = torch.where(
                    cand_valid,
                    torch.relu(cand_g).square(),
                    torch.zeros_like(cand_g),
                ).sum(dim=-1)
            improve = cand_violation < (
                old_violation - float(config.dense_constraint_recovery_min_improvement)
            )
            nonincrease_peak = cand_max <= (old_max + 1.0e-8)
            accept = trial_active & improve & nonincrease_peak
            current_xy = torch.where(accept[..., None, None], candidate, current_xy)
            accepted |= accept
            rejected = trial_active & ~accept
            if trial + 1 < max_trials:
                backtracking = backtracking + rejected.to(dtype)
                step = torch.where(
                    rejected,
                    step * float(config.dense_backtracking_factor),
                    step,
                ).clamp_min(float(config.dense_min_step_m))

        accepted_count = accepted_count + accepted.to(dtype)

        # Dual ascent is performed even when the primal candidate is rejected;
        # persistent violations therefore receive progressively larger weight.
        with torch.no_grad():
            _, curv_dual, valid_dual, _ = evaluate_fn(
                current_xy, allow_input_gradient=False
            )
            abs_dual = curv_dual.abs()
            g_dual = abs_dual - float(config.curvature_limit)
            dual_active = valid_dual & (
                abs_dual
                >= float(config.curvature_limit)
                - float(config.dense_alm_active_margin)
            )
            dual = torch.where(
                dual_active,
                torch.clamp(
                    dual + float(config.dense_alm_dual_step) * g_dual,
                    min=0.0,
                    max=float(config.dense_alm_lambda_max),
                ),
                torch.zeros_like(dual),
            )
            max_after_iter = torch.where(
                valid_dual, abs_dual, torch.zeros_like(abs_dual)
            ).amax(dim=-1)
        if not bool((trigger & (max_after_iter > float(config.curvature_limit) + 1e-8)).any().item()):
            break

    with torch.no_grad():
        end_max, _, _ = _constraint_max_state(evaluate_fn, current_xy)
        trigger_count = trigger.to(dtype).sum().clamp_min(1.0)
        lambda_active = dual[dual > 0.0]
        mean_lambda = (
            lambda_active.mean() if lambda_active.numel() > 0
            else torch.zeros((), device=device, dtype=dtype)
        )
        max_lambda = (
            dual.max() if dual.numel() > 0
            else torch.zeros((), device=device, dtype=dtype)
        )
    return current_xy, {
        "trigger": trigger,
        "start_max": start_max,
        "end_max": end_max,
        "accepted": accepted_count,
        "backtracking": backtracking,
        "mean_lambda": mean_lambda,
        "max_lambda": max_lambda,
    }


def _run_execution_projection_recovery(
    current_xy: torch.Tensor,
    *,
    anchor_xy: torch.Tensor,
    mode_valid: torch.Tensor,
    config: SparseCurvatureGuidanceConfig,
    evaluate_fn,
):
    dtype = current_xy.dtype
    device = current_xy.device
    target = max(
        float(config.curvature_limit) - float(config.dense_projection_tightening),
        float(config.eps),
    )
    with torch.no_grad():
        start_max, _, _ = _constraint_max_state(evaluate_fn, current_xy)
    trigger = mode_valid & (
        start_max > float(config.dense_constraint_recovery_threshold) + 1.0e-8
    )
    accepted_count = torch.zeros(trigger.shape, device=device, dtype=dtype)
    backtracking = torch.zeros_like(accepted_count)
    requested_step_sum = torch.zeros_like(accepted_count)

    for _ in range(int(config.dense_projection_iters)):
        with torch.enable_grad():
            x_var = current_xy.detach().requires_grad_(True)
            _, curvature, valid, _ = evaluate_fn(
                x_var,
                allow_input_gradient=bool(config.dense_residual_gradient_enabled),
            )
            abs_curvature = torch.where(
                valid,
                curvature.abs(),
                torch.zeros_like(curvature),
            )
            max_now = abs_curvature.amax(dim=-1)
            active = trigger & (max_now > target + 1.0e-8)
            # One backward pass returns the Jacobian of each mode's currently
            # worst active constraint because modes are independent.
            objective = (max_now * active.to(dtype)).sum()
            if not objective.requires_grad:
                break
            jacobian = torch.autograd.grad(objective, x_var)[0]
            jacobian = jacobian * active[..., None, None].to(dtype)
            if config.preserve_endpoint:
                jacobian = jacobian.clone()
                jacobian[..., -1, :] = 0.0
            jac_norm_sq = jacobian.square().sum(dim=(-1, -2))
            gap = (max_now - target).clamp_min(0.0)
            alpha = (
                float(config.dense_projection_safety_factor)
                * gap
                / jac_norm_sq.clamp_min(float(config.eps))
            )
            delta = alpha[..., None, None] * jacobian
            delta_norm = torch.linalg.vector_norm(
                delta.flatten(start_dim=-2), dim=-1
            )
            step_cap = float(config.dense_projection_max_step_m)
            cap_scale = (step_cap / delta_norm.clamp_min(float(config.eps))).clamp(max=1.0)
            delta = delta * cap_scale[..., None, None]
            requested_step = torch.linalg.vector_norm(
                delta.flatten(start_dim=-2), dim=-1
            ).detach()
            active = active & (jac_norm_sq > float(config.eps))
            old_max = max_now.detach()

        if not bool(active.any().item()):
            break

        accepted = torch.zeros_like(active)
        trial_scale = torch.ones_like(old_max)
        max_trials = (
            int(config.dense_backtracking_max_trials)
            if config.dense_backtracking_enabled else 1
        )
        for trial in range(max_trials):
            trial_active = active & ~accepted
            if not bool(trial_active.any().item()):
                break
            candidate = current_xy - trial_scale[..., None, None] * delta.detach()
            candidate = _apply_stage_trust_region(
                candidate,
                anchor_xy,
                float(config.dense_constraint_recovery_max_total_move_m),
                eps=config.eps,
            )
            if config.preserve_endpoint:
                candidate = candidate.clone()
                candidate[..., -1, :] = anchor_xy[..., -1, :]
            with torch.no_grad():
                cand_max, _, _ = _constraint_max_state(evaluate_fn, candidate)
            accept = trial_active & (
                cand_max
                <= old_max - float(config.dense_constraint_recovery_min_improvement)
            )
            current_xy = torch.where(accept[..., None, None], candidate, current_xy)
            accepted |= accept
            rejected = trial_active & ~accept
            if trial + 1 < max_trials:
                backtracking = backtracking + rejected.to(dtype)
                trial_scale = torch.where(
                    rejected,
                    trial_scale * float(config.dense_backtracking_factor),
                    trial_scale,
                )

        requested_step_sum = requested_step_sum + requested_step * accepted.to(dtype)
        accepted_count = accepted_count + accepted.to(dtype)
        if not bool(accepted.any().item()):
            break

    with torch.no_grad():
        end_max, _, _ = _constraint_max_state(evaluate_fn, current_xy)
    return current_xy, {
        "trigger": trigger,
        "start_max": start_max,
        "end_max": end_max,
        "accepted": accepted_count,
        "backtracking": backtracking,
        "requested_step_sum": requested_step_sum,
    }

def apply_dense_curvature_guidance(
    predicted_x0_norm: torch.Tensor,
    *,
    trajectory_scale: torch.Tensor,
    mode_valid_mask: torch.Tensor,
    config: SparseCurvatureGuidanceConfig,
    timestep: int,
    trajectory_spline,
    start_velocity_xy: torch.Tensor,
    mode_features: Optional[torch.Tensor] = None,
    execution_residual_head=None,
    allow_polish: bool = True,
    allow_adaptive_normal: bool = True,
) -> tuple[torch.Tensor, Optional[dict[str, torch.Tensor]]]:
    """Dense V3: iterative trust-region projection on execution curvature.

    V3 adds five pieces over V2: repeated inner optimization, backtracking
    acceptance, a composite all-violation/peak/dkappa loss, full input
    Jacobian through the frozen residual head, and local-normal projection.
    Network parameters are never updated; autograd is requested only w.r.t.
    the temporary trajectory variable.
    """
    if (
        not config.applies_to(int(timestep))
        or config.guidance_type != "dense_curvature"
    ):
        return predicted_x0_norm, None
    if predicted_x0_norm.ndim != 4 or predicted_x0_norm.shape[-1] != 2:
        raise ValueError(
            "predicted_x0_norm must be [B,M,H,2], got "
            f"{tuple(predicted_x0_norm.shape)}"
        )
    if tuple(mode_valid_mask.shape) != tuple(predicted_x0_norm.shape[:2]):
        raise ValueError("mode_valid_mask shape mismatch for dense guidance")

    scale_xy = trajectory_scale.to(
        device=predicted_x0_norm.device,
        dtype=predicted_x0_norm.dtype,
    )
    batch, modes, horizon, _ = predicted_x0_norm.shape
    mode_valid = mode_valid_mask.bool()
    mode_valid_f = mode_valid.to(dtype=predicted_x0_norm.dtype)

    def execution_points(
        physical_xy: torch.Tensor,
        *,
        allow_input_gradient: bool,
    ) -> torch.Tensor:
        if execution_residual_head is None:
            return physical_xy
        if mode_features is None:
            raise ValueError(
                "mode_features are required when execution_residual_head is used"
            )

        # DENSE_RESIDUAL_JACOBIAN_FIX_V3_1
        flat_feature = mode_features.detach().reshape(batch * modes, -1)
        flat_norm_source = physical_xy / scale_xy
        if not allow_input_gradient:
            flat_norm_source = flat_norm_source.detach()
        flat_norm = flat_norm_source.reshape(batch * modes, horizon, 2)

        if allow_input_gradient:
            guidance_forward = getattr(
                execution_residual_head,
                "forward_guidance",
                None,
            )
            if guidance_forward is None:
                raise RuntimeError(
                    "dense_residual_gradient_enabled=True requires "
                    "DenseSparseResidualHead.forward_guidance()"
                )
            residual = guidance_forward(flat_feature, flat_norm)
        else:
            # Historical training/runtime semantics: the residual head internally
            # detaches sparse_norm, preserving the old hard stop-gradient.
            residual = execution_residual_head(flat_feature, flat_norm)

        residual = residual.reshape(batch, modes, horizon, 2)
        if not allow_input_gradient:
            residual = residual.detach()
        return physical_xy + residual.to(
            device=physical_xy.device,
            dtype=physical_xy.dtype,
        )

    def evaluate(
        physical_xy: torch.Tensor,
        *,
        allow_input_gradient: bool,
        bound_weight: Optional[float] = None,
        peak_weight: Optional[float] = None,
        dkappa_weight: Optional[float] = None,
        peak_alpha: Optional[float] = None,
    ):
        execution_xy = execution_points(
            physical_xy,
            allow_input_gradient=allow_input_gradient,
        )
        return _dense_loss_per_mode(
            execution_xy,
            trajectory_spline=trajectory_spline,
            start_velocity_xy=start_velocity_xy,
            curvature_limit=config.curvature_limit,
            topk_fraction=config.dense_topk_fraction,
            min_segment_m=config.dense_min_segment_m,
            eps=config.eps,
            bound_weight=(
                config.dense_bound_weight
                if bound_weight is None else float(bound_weight)
            ),
            peak_weight=(
                config.dense_peak_weight
                if peak_weight is None else float(peak_weight)
            ),
            dkappa_weight=(
                config.dense_dkappa_weight
                if dkappa_weight is None else float(dkappa_weight)
            ),
            peak_alpha=(
                config.dense_peak_alpha
                if peak_alpha is None else float(peak_alpha)
            ),
        )

    initial_xy = (predicted_x0_norm.detach() * scale_xy).detach()
    current_xy = initial_xy.clone()

    with torch.no_grad():
        loss_before, curvature_before, valid_before, components_before = evaluate(
            current_xy,
            allow_input_gradient=False,
        )

    accepted_inner = torch.zeros(
        (batch, modes), device=current_xy.device, dtype=current_xy.dtype
    )
    backtracking_reductions = torch.zeros_like(accepted_inner)
    # DENSE_GUIDANCE_G2_ADAPTIVE_NORMAL_V3_3 diagnostics: maximum tangent
    # freedom granted to each mode over all accepted/attempted inner steps.
    adaptive_tangent_weight_max = torch.zeros_like(accepted_inner)

    for _ in range(int(config.dense_inner_iters)):
        with torch.enable_grad():
            x_var = current_xy.detach().requires_grad_(True)
            loss_mode, curvature_now, valid_now, components_now = evaluate(
                x_var,
                allow_input_gradient=bool(
                    config.dense_residual_gradient_enabled
                ),
            )
            objective = (loss_mode * mode_valid_f).sum()
            if not objective.requires_grad:
                break
            gradient = torch.autograd.grad(
                objective,
                x_var,
                create_graph=False,
                retain_graph=False,
                allow_unused=False,
            )[0]
            gradient = gradient * mode_valid_f[..., None, None]

            if config.dense_normal_projection_enabled:
                normal_gradient = _project_gradient_to_sparse_normals(
                    gradient,
                    x_var,
                    eps=config.eps,
                )
                if (config.dense_adaptive_normal_enabled) and bool(allow_adaptive_normal):
                    current_max_curvature = torch.where(
                        valid_now,
                        curvature_now.detach().abs(),
                        torch.zeros_like(curvature_now),
                    ).amax(dim=-1)
                    tangent_weight = torch.zeros_like(current_max_curvature)
                    medium_mask = (
                        current_max_curvature
                        > float(config.dense_adaptive_normal_medium_curvature)
                    ) & (
                        current_max_curvature
                        <= float(config.dense_adaptive_normal_hard_curvature)
                    )
                    hard_mask = (
                        current_max_curvature
                        > float(config.dense_adaptive_normal_hard_curvature)
                    )
                    tangent_weight = torch.where(
                        medium_mask,
                        torch.full_like(
                            tangent_weight,
                            float(config.dense_adaptive_normal_medium_tangent_weight),
                        ),
                        tangent_weight,
                    )
                    tangent_weight = torch.where(
                        hard_mask,
                        torch.full_like(
                            tangent_weight,
                            float(config.dense_adaptive_normal_hard_tangent_weight),
                        ),
                        tangent_weight,
                    )
                    tangent_weight = tangent_weight * mode_valid_f
                    adaptive_tangent_weight_max = torch.maximum(
                        adaptive_tangent_weight_max,
                        tangent_weight.detach(),
                    )
                    adaptive_gradient = _blend_gradient_with_sparse_tangent(
                        gradient,
                        x_var,
                        tangent_weight,
                        eps=config.eps,
                    )
                    # Preserve the exact F'+G1.1 direction for modes below
                    # the G2 threshold.
                    gradient = torch.where(
                        (tangent_weight > 0.0)[..., None, None],
                        adaptive_gradient,
                        normal_gradient,
                    )
                else:
                    gradient = normal_gradient

            if config.preserve_endpoint:
                gradient = gradient.clone()
                gradient[..., -1, :] = 0.0

            grad_norm = torch.linalg.vector_norm(
                gradient.flatten(start_dim=-2), dim=-1
            )
            direction = gradient / grad_norm.clamp_min(
                float(config.eps)
            )[..., None, None]
            active = (
                mode_valid
                & (grad_norm > float(config.eps))
                & components_now["has_violation"]
            )

        if not bool(active.any().item()):
            break

        old_loss = loss_mode.detach()
        old_max = torch.where(
            valid_now,
            curvature_now.detach().abs(),
            torch.zeros_like(curvature_now),
        ).amax(dim=-1)

        accepted_this = torch.zeros_like(active)
        step = torch.full_like(
            old_loss,
            float(config.dense_step_m),
        )
        max_trials = (
            int(config.dense_backtracking_max_trials)
            if config.dense_backtracking_enabled
            else 1
        )

        for trial in range(max_trials):
            trial_active = active & ~accepted_this
            if not bool(trial_active.any().item()):
                break

            candidate = current_xy - step[..., None, None] * direction.detach()
            delta = candidate - initial_xy
            total_move = torch.linalg.vector_norm(
                delta.flatten(start_dim=-2), dim=-1
            )
            trust_scale = (
                float(config.dense_max_total_move_m)
                / total_move.clamp_min(float(config.eps))
            ).clamp(max=1.0)
            candidate = initial_xy + delta * trust_scale[..., None, None]
            if config.preserve_endpoint:
                candidate = candidate.clone()
                candidate[..., -1, :] = initial_xy[..., -1, :]

            with torch.no_grad():
                cand_loss, cand_curvature, cand_valid, _ = evaluate(
                    candidate,
                    allow_input_gradient=False,
                )
                cand_max = torch.where(
                    cand_valid,
                    cand_curvature.abs(),
                    torch.zeros_like(cand_curvature),
                ).amax(dim=-1)

            if config.dense_backtracking_enabled:
                improved_loss = cand_loss < (old_loss - 1.0e-8)
                nonincreasing_peak = cand_max <= (old_max + 1.0e-8)
                accept = trial_active & improved_loss & nonincreasing_peak
            else:
                accept = trial_active

            current_xy = torch.where(
                accept[..., None, None],
                candidate,
                current_xy,
            )
            accepted_this |= accept

            rejected = trial_active & ~accept
            if trial + 1 < max_trials:
                backtracking_reductions = (
                    backtracking_reductions + rejected.to(current_xy.dtype)
                )
                step = torch.where(
                    rejected,
                    step * float(config.dense_backtracking_factor),
                    step,
                )
                step = step.clamp_min(float(config.dense_min_step_m))

        accepted_inner = accepted_inner + accepted_this.to(current_xy.dtype)
        if not bool(accepted_this.any().item()):
            break

    # DENSE_GUIDANCE_G1_POLISHING_V3_2
    # A second, conservative feasibility-polishing stage is used only for
    # trajectories that are already close to the hard curvature boundary.
    # It deliberately removes the d-kappa term: at this stage the goal is to
    # cross the feasibility boundary without changing the main F' solver.
    polish_start_xy = current_xy.clone()
    polish_triggered = torch.zeros_like(mode_valid)
    polish_accepted = torch.zeros(
        (batch, modes), device=current_xy.device, dtype=current_xy.dtype
    )
    polish_backtracking = torch.zeros_like(polish_accepted)

    if (bool(config.dense_polish_enabled)) and bool(allow_polish):
        with torch.no_grad():
            _, polish_curvature0, polish_valid0, _ = evaluate(
                current_xy,
                allow_input_gradient=False,
                dkappa_weight=0.0,
            )
            polish_max0 = torch.where(
                polish_valid0,
                polish_curvature0.abs(),
                torch.zeros_like(polish_curvature0),
            ).amax(dim=-1)
            polish_triggered = (
                mode_valid
                & (polish_max0 > float(config.curvature_limit) + 1.0e-8)
                & (polish_max0 <= float(config.dense_polish_max_curvature) + 1.0e-8)
            )

        for _ in range(int(config.dense_polish_iters)):
            with torch.enable_grad():
                x_var = current_xy.detach().requires_grad_(True)
                polish_loss, polish_curvature, polish_valid, polish_components = evaluate(
                    x_var,
                    allow_input_gradient=bool(
                        config.dense_residual_gradient_enabled
                    ),
                    dkappa_weight=0.0,
                )
                polish_max = torch.where(
                    polish_valid,
                    polish_curvature.abs(),
                    torch.zeros_like(polish_curvature),
                ).amax(dim=-1)
                polish_window = (
                    polish_triggered
                    & (polish_max > float(config.curvature_limit) + 1.0e-8)
                    & (polish_max <= float(config.dense_polish_max_curvature) + 1.0e-8)
                )
                objective = (
                    polish_loss * polish_window.to(polish_loss.dtype)
                ).sum()
                if not objective.requires_grad:
                    break
                gradient = torch.autograd.grad(
                    objective,
                    x_var,
                    create_graph=False,
                    retain_graph=False,
                    allow_unused=False,
                )[0]
                gradient = gradient * polish_window[..., None, None].to(gradient.dtype)

                if config.dense_normal_projection_enabled:
                    gradient = _project_gradient_to_sparse_normals(
                        gradient,
                        x_var,
                        eps=config.eps,
                    )
                if config.preserve_endpoint:
                    gradient = gradient.clone()
                    gradient[..., -1, :] = 0.0

                grad_norm = torch.linalg.vector_norm(
                    gradient.flatten(start_dim=-2), dim=-1
                )
                direction = gradient / grad_norm.clamp_min(
                    float(config.eps)
                )[..., None, None]
                active = (
                    polish_window
                    & (grad_norm > float(config.eps))
                    & polish_components["has_violation"]
                )

            if not bool(active.any().item()):
                break

            old_loss = polish_loss.detach()
            old_max = polish_max.detach()
            accepted_this = torch.zeros_like(active)
            step = torch.full_like(
                old_loss, float(config.dense_polish_step_m)
            )
            max_trials = (
                int(config.dense_backtracking_max_trials)
                if config.dense_backtracking_enabled else 1
            )

            for trial in range(max_trials):
                trial_active = active & ~accepted_this
                if not bool(trial_active.any().item()):
                    break

                candidate = current_xy - step[..., None, None] * direction.detach()
                delta = candidate - initial_xy
                total_move = torch.linalg.vector_norm(
                    delta.flatten(start_dim=-2), dim=-1
                )
                trust_scale = (
                    float(config.dense_max_total_move_m)
                    / total_move.clamp_min(float(config.eps))
                ).clamp(max=1.0)
                candidate = initial_xy + delta * trust_scale[..., None, None]
                if config.preserve_endpoint:
                    candidate = candidate.clone()
                    candidate[..., -1, :] = initial_xy[..., -1, :]

                with torch.no_grad():
                    cand_loss, cand_curvature, cand_valid, _ = evaluate(
                        candidate,
                        allow_input_gradient=False,
                        dkappa_weight=0.0,
                    )
                    cand_max = torch.where(
                        cand_valid,
                        cand_curvature.abs(),
                        torch.zeros_like(cand_curvature),
                    ).amax(dim=-1)

                if config.dense_backtracking_enabled:
                    improved_loss = cand_loss < (old_loss - 1.0e-8)
                    nonincreasing_peak = cand_max <= (old_max + 1.0e-8)
                    accept = trial_active & improved_loss & nonincreasing_peak
                else:
                    accept = trial_active

                current_xy = torch.where(
                    accept[..., None, None], candidate, current_xy
                )
                accepted_this |= accept

                rejected = trial_active & ~accept
                if trial + 1 < max_trials:
                    polish_backtracking = (
                        polish_backtracking + rejected.to(current_xy.dtype)
                    )
                    step = torch.where(
                        rejected,
                        step * float(config.dense_backtracking_factor),
                        step,
                    )
                    step = step.clamp_min(float(config.dense_min_step_m))

            polish_accepted = (
                polish_accepted + accepted_this.to(current_xy.dtype)
            )
            if not bool(accepted_this.any().item()):
                break

    # DENSE_GUIDANCE_CASCADE_RECOVERY_V3_5
    # Unified post-baseline recovery. The trigger mask is frozen only after
    # F' + first G1.x polishing has fully completed, so easy/feasible modes
    # stay untouched. Strategies:
    #   normal           -> C1/F# optimization-budget recovery
    #   adaptive_tangent -> G2.2 direction/DOF recovery
    #   adaptive_trust   -> G3 search-range recovery
    polish_end_xy = current_xy.clone()
    post_recovery_start_xy = current_xy.clone()
    post_recovery_triggered = torch.zeros_like(mode_valid)
    post_recovery_accepted = torch.zeros(
        (batch, modes), device=current_xy.device, dtype=current_xy.dtype
    )
    post_recovery_backtracking = torch.zeros_like(post_recovery_accepted)
    post_recovery_tangent_weight_max = torch.zeros_like(post_recovery_accepted)
    post_recovery_trust_limit = torch.full_like(
        post_recovery_accepted,
        float(config.dense_post_recovery_max_total_move_m),
    )

    if bool(config.dense_post_recovery_enabled) and bool(allow_polish):
        if float(config.dense_post_recovery_threshold) <= float(config.curvature_limit):
            raise ValueError(
                "dense_post_recovery_threshold must exceed curvature_limit"
            )
        if int(config.dense_post_recovery_iters) < 1:
            raise ValueError("dense_post_recovery_iters must be >= 1")
        if float(config.dense_post_recovery_step_m) <= 0.0:
            raise ValueError("dense_post_recovery_step_m must be positive")
        if float(config.dense_post_recovery_max_total_move_m) <= 0.0:
            raise ValueError(
                "dense_post_recovery_max_total_move_m must be positive"
            )

        with torch.no_grad():
            _, recovery_curvature0, recovery_valid0, _ = evaluate(
                current_xy,
                allow_input_gradient=False,
            )
            recovery_max0 = torch.where(
                recovery_valid0,
                recovery_curvature0.abs(),
                torch.zeros_like(recovery_curvature0),
            ).amax(dim=-1)
            # Freeze hard-tail membership from the COMPLETE baseline trajectory.
            post_recovery_triggered = (
                mode_valid
                & (
                    recovery_max0
                    > float(config.dense_post_recovery_threshold) + 1.0e-8
                )
            )

            if config.dense_post_recovery_strategy == "adaptive_trust":
                medium_limit = torch.full_like(
                    recovery_max0,
                    float(config.dense_post_recovery_medium_max_total_move_m),
                )
                hard_limit = torch.full_like(
                    recovery_max0,
                    float(config.dense_post_recovery_hard_max_total_move_m),
                )
                adaptive_limit = torch.where(
                    recovery_max0
                    > float(config.dense_post_recovery_hard_curvature),
                    hard_limit,
                    medium_limit,
                )
                post_recovery_trust_limit = torch.where(
                    post_recovery_triggered,
                    adaptive_limit,
                    post_recovery_trust_limit,
                )

        for _ in range(int(config.dense_post_recovery_iters)):
            with torch.enable_grad():
                x_var = current_xy.detach().requires_grad_(True)
                recovery_loss, recovery_curvature, recovery_valid, recovery_components = evaluate(
                    x_var,
                    allow_input_gradient=bool(
                        config.dense_residual_gradient_enabled
                    ),
                )
                recovery_max = torch.where(
                    recovery_valid,
                    recovery_curvature.abs(),
                    torch.zeros_like(recovery_curvature),
                ).amax(dim=-1)
                recovery_window = (
                    post_recovery_triggered
                    & (
                        recovery_max
                        > float(config.curvature_limit) + 1.0e-8
                    )
                )
                objective = (
                    recovery_loss
                    * recovery_window.to(recovery_loss.dtype)
                ).sum()
                if not objective.requires_grad:
                    break
                raw_gradient = torch.autograd.grad(
                    objective,
                    x_var,
                    create_graph=False,
                    retain_graph=False,
                    allow_unused=False,
                )[0]
                raw_gradient = raw_gradient * recovery_window[..., None, None].to(
                    raw_gradient.dtype
                )

                gradient = raw_gradient
                if config.dense_normal_projection_enabled:
                    normal_gradient = _project_gradient_to_sparse_normals(
                        raw_gradient,
                        x_var,
                        eps=config.eps,
                    )
                    if config.dense_post_recovery_strategy == "adaptive_tangent":
                        tangent_weight = torch.zeros_like(recovery_max)
                        medium_mask = (
                            post_recovery_triggered
                            & (
                                recovery_max
                                > float(config.dense_post_recovery_threshold)
                            )
                            & (
                                recovery_max
                                <= float(config.dense_post_recovery_hard_curvature)
                            )
                        )
                        hard_mask = (
                            post_recovery_triggered
                            & (
                                recovery_max
                                > float(config.dense_post_recovery_hard_curvature)
                            )
                        )
                        tangent_weight = torch.where(
                            medium_mask,
                            torch.full_like(
                                tangent_weight,
                                float(config.dense_post_recovery_medium_tangent_weight),
                            ),
                            tangent_weight,
                        )
                        tangent_weight = torch.where(
                            hard_mask,
                            torch.full_like(
                                tangent_weight,
                                float(config.dense_post_recovery_hard_tangent_weight),
                            ),
                            tangent_weight,
                        )
                        post_recovery_tangent_weight_max = torch.maximum(
                            post_recovery_tangent_weight_max,
                            tangent_weight.detach(),
                        )
                        adaptive_gradient = _blend_gradient_with_sparse_tangent(
                            raw_gradient,
                            x_var,
                            tangent_weight,
                            eps=config.eps,
                        )
                        gradient = torch.where(
                            (tangent_weight > 0.0)[..., None, None],
                            adaptive_gradient,
                            normal_gradient,
                        )
                    else:
                        gradient = normal_gradient

                if config.preserve_endpoint:
                    gradient = gradient.clone()
                    gradient[..., -1, :] = 0.0

                grad_norm = torch.linalg.vector_norm(
                    gradient.flatten(start_dim=-2), dim=-1
                )
                direction = gradient / grad_norm.clamp_min(
                    float(config.eps)
                )[..., None, None]
                active = (
                    recovery_window
                    & (grad_norm > float(config.eps))
                    & recovery_components["has_violation"]
                )

            if not bool(active.any().item()):
                break

            old_loss = recovery_loss.detach()
            old_max = recovery_max.detach()
            accepted_this = torch.zeros_like(active)
            step = torch.full_like(
                old_loss, float(config.dense_post_recovery_step_m)
            )
            max_trials = (
                int(config.dense_backtracking_max_trials)
                if config.dense_backtracking_enabled else 1
            )

            for trial in range(max_trials):
                trial_active = active & ~accepted_this
                if not bool(trial_active.any().item()):
                    break

                candidate = current_xy - step[..., None, None] * direction.detach()
                # Every recovery strategy keeps a global trust region relative
                # to the ORIGINAL diffusion x0. Only G3 changes its radius.
                delta = candidate - initial_xy
                total_move = torch.linalg.vector_norm(
                    delta.flatten(start_dim=-2), dim=-1
                )
                trust_scale = (
                    post_recovery_trust_limit
                    / total_move.clamp_min(float(config.eps))
                ).clamp(max=1.0)
                candidate = initial_xy + delta * trust_scale[..., None, None]
                if config.preserve_endpoint:
                    candidate = candidate.clone()
                    candidate[..., -1, :] = initial_xy[..., -1, :]

                with torch.no_grad():
                    cand_loss, cand_curvature, cand_valid, _ = evaluate(
                        candidate,
                        allow_input_gradient=False,
                    )
                    cand_max = torch.where(
                        cand_valid,
                        cand_curvature.abs(),
                        torch.zeros_like(cand_curvature),
                    ).amax(dim=-1)

                if config.dense_backtracking_enabled:
                    improved_loss = cand_loss < (old_loss - 1.0e-8)
                    nonincreasing_peak = cand_max <= (old_max + 1.0e-8)
                    accept = trial_active & improved_loss & nonincreasing_peak
                else:
                    accept = trial_active

                current_xy = torch.where(
                    accept[..., None, None], candidate, current_xy
                )
                accepted_this |= accept

                rejected = trial_active & ~accept
                if trial + 1 < max_trials:
                    post_recovery_backtracking = (
                        post_recovery_backtracking
                        + rejected.to(current_xy.dtype)
                    )
                    step = torch.where(
                        rejected,
                        step * float(config.dense_backtracking_factor),
                        step,
                    )
                    step = step.clamp_min(float(config.dense_min_step_m))

            post_recovery_accepted = (
                post_recovery_accepted
                + accepted_this.to(current_xy.dtype)
            )
            if not bool(accepted_this.any().item()):
                break

    post_recovery_end_xy = current_xy.clone()

    # C1/G2.2/G3 can optionally cascade into a SECOND G1-style polishing pass.
    # Only modes that were hard-tail after the original baseline AND have now
    # entered (curvature_limit, post_recovery_threshold] are eligible.
    second_polish_start_xy = current_xy.clone()
    second_polish_triggered = torch.zeros_like(mode_valid)
    second_polish_accepted = torch.zeros_like(post_recovery_accepted)
    second_polish_backtracking = torch.zeros_like(post_recovery_backtracking)

    if (
        bool(config.dense_post_recovery_enabled)
        and bool(config.dense_post_recovery_second_polish_enabled)
        and bool(allow_polish)
    ):
        with torch.no_grad():
            _, second_curvature0, second_valid0, _ = evaluate(
                current_xy,
                allow_input_gradient=False,
                dkappa_weight=0.0,
            )
            second_max0 = torch.where(
                second_valid0,
                second_curvature0.abs(),
                torch.zeros_like(second_curvature0),
            ).amax(dim=-1)
            second_polish_triggered = (
                post_recovery_triggered
                & (second_max0 > float(config.curvature_limit) + 1.0e-8)
                & (
                    second_max0
                    <= float(config.dense_post_recovery_threshold) + 1.0e-8
                )
            )

        for _ in range(int(config.dense_post_recovery_second_polish_iters)):
            with torch.enable_grad():
                x_var = current_xy.detach().requires_grad_(True)
                second_loss, second_curvature, second_valid, second_components = evaluate(
                    x_var,
                    allow_input_gradient=bool(
                        config.dense_residual_gradient_enabled
                    ),
                    dkappa_weight=0.0,
                )
                second_max = torch.where(
                    second_valid,
                    second_curvature.abs(),
                    torch.zeros_like(second_curvature),
                ).amax(dim=-1)
                second_window = (
                    second_polish_triggered
                    & (second_max > float(config.curvature_limit) + 1.0e-8)
                    & (
                        second_max
                        <= float(config.dense_post_recovery_threshold) + 1.0e-8
                    )
                )
                objective = (
                    second_loss * second_window.to(second_loss.dtype)
                ).sum()
                if not objective.requires_grad:
                    break
                gradient = torch.autograd.grad(
                    objective,
                    x_var,
                    create_graph=False,
                    retain_graph=False,
                    allow_unused=False,
                )[0]
                gradient = gradient * second_window[..., None, None].to(
                    gradient.dtype
                )
                if config.dense_normal_projection_enabled:
                    gradient = _project_gradient_to_sparse_normals(
                        gradient,
                        x_var,
                        eps=config.eps,
                    )
                if config.preserve_endpoint:
                    gradient = gradient.clone()
                    gradient[..., -1, :] = 0.0

                grad_norm = torch.linalg.vector_norm(
                    gradient.flatten(start_dim=-2), dim=-1
                )
                direction = gradient / grad_norm.clamp_min(
                    float(config.eps)
                )[..., None, None]
                active = (
                    second_window
                    & (grad_norm > float(config.eps))
                    & second_components["has_violation"]
                )

            if not bool(active.any().item()):
                break

            old_loss = second_loss.detach()
            old_max = second_max.detach()
            accepted_this = torch.zeros_like(active)
            step = torch.full_like(
                old_loss,
                float(config.dense_post_recovery_second_polish_step_m),
            )
            max_trials = (
                int(config.dense_backtracking_max_trials)
                if config.dense_backtracking_enabled else 1
            )

            for trial in range(max_trials):
                trial_active = active & ~accepted_this
                if not bool(trial_active.any().item()):
                    break

                candidate = current_xy - step[..., None, None] * direction.detach()
                delta = candidate - initial_xy
                total_move = torch.linalg.vector_norm(
                    delta.flatten(start_dim=-2), dim=-1
                )
                trust_scale = (
                    post_recovery_trust_limit
                    / total_move.clamp_min(float(config.eps))
                ).clamp(max=1.0)
                candidate = initial_xy + delta * trust_scale[..., None, None]
                if config.preserve_endpoint:
                    candidate = candidate.clone()
                    candidate[..., -1, :] = initial_xy[..., -1, :]

                with torch.no_grad():
                    cand_loss, cand_curvature, cand_valid, _ = evaluate(
                        candidate,
                        allow_input_gradient=False,
                        dkappa_weight=0.0,
                    )
                    cand_max = torch.where(
                        cand_valid,
                        cand_curvature.abs(),
                        torch.zeros_like(cand_curvature),
                    ).amax(dim=-1)

                if config.dense_backtracking_enabled:
                    improved_loss = cand_loss < (old_loss - 1.0e-8)
                    nonincreasing_peak = cand_max <= (old_max + 1.0e-8)
                    accept = trial_active & improved_loss & nonincreasing_peak
                else:
                    accept = trial_active

                current_xy = torch.where(
                    accept[..., None, None], candidate, current_xy
                )
                accepted_this |= accept

                rejected = trial_active & ~accept
                if trial + 1 < max_trials:
                    second_polish_backtracking = (
                        second_polish_backtracking
                        + rejected.to(current_xy.dtype)
                    )
                    step = torch.where(
                        rejected,
                        step * float(config.dense_backtracking_factor),
                        step,
                    )
                    step = step.clamp_min(float(config.dense_min_step_m))

            second_polish_accepted = (
                second_polish_accepted
                + accepted_this.to(current_xy.dtype)
            )
            if not bool(accepted_this.any().item()):
                break

    second_polish_end_xy = current_xy.clone()

    # DENSE_GUIDANCE_PEAK_RECOVERY_V3_6
    # G4: after the complete F' -> G1.2 -> G3/G3+ -> second-polish cascade,
    # attack only trajectories whose FINAL max curvature is still > threshold.
    # This stage keeps normal-only geometry and the already-selected G3 trust
    # radius, but optimizes a peak-dominant objective and accepts a candidate
    # only when max|kappa| itself decreases by a measurable amount.
    peak_recovery_start_xy = current_xy.clone()
    peak_recovery_triggered = torch.zeros_like(mode_valid)
    peak_recovery_accepted = torch.zeros(
        (batch, modes), device=current_xy.device, dtype=current_xy.dtype
    )
    peak_recovery_backtracking = torch.zeros_like(peak_recovery_accepted)
    peak_recovery_start_max = torch.zeros_like(peak_recovery_accepted)

    if bool(config.dense_peak_recovery_enabled) and bool(allow_polish):
        with torch.no_grad():
            _, peak_curvature0, peak_valid0, _ = evaluate(
                current_xy,
                allow_input_gradient=False,
                bound_weight=float(config.dense_peak_recovery_bound_weight),
                peak_weight=float(config.dense_peak_recovery_peak_weight),
                dkappa_weight=float(config.dense_peak_recovery_dkappa_weight),
                peak_alpha=float(config.dense_peak_recovery_peak_alpha),
            )
            peak_recovery_start_max = torch.where(
                peak_valid0,
                peak_curvature0.abs(),
                torch.zeros_like(peak_curvature0),
            ).amax(dim=-1)
            peak_recovery_triggered = (
                mode_valid
                & (
                    peak_recovery_start_max
                    > float(config.dense_peak_recovery_threshold) + 1.0e-8
                )
            )

        for _ in range(int(config.dense_peak_recovery_iters)):
            with torch.enable_grad():
                x_var = current_xy.detach().requires_grad_(True)
                peak_loss, peak_curvature, peak_valid, peak_components = evaluate(
                    x_var,
                    allow_input_gradient=bool(
                        config.dense_residual_gradient_enabled
                    ),
                    bound_weight=float(config.dense_peak_recovery_bound_weight),
                    peak_weight=float(config.dense_peak_recovery_peak_weight),
                    dkappa_weight=float(config.dense_peak_recovery_dkappa_weight),
                    peak_alpha=float(config.dense_peak_recovery_peak_alpha),
                )
                peak_max = torch.where(
                    peak_valid,
                    peak_curvature.abs(),
                    torch.zeros_like(peak_curvature),
                ).amax(dim=-1)
                peak_window = (
                    peak_recovery_triggered
                    & (
                        peak_max
                        > float(config.curvature_limit) + 1.0e-8
                    )
                )
                objective = (
                    peak_loss * peak_window.to(peak_loss.dtype)
                ).sum()
                if not objective.requires_grad:
                    break
                gradient = torch.autograd.grad(
                    objective,
                    x_var,
                    create_graph=False,
                    retain_graph=False,
                    allow_unused=False,
                )[0]
                gradient = gradient * peak_window[..., None, None].to(
                    gradient.dtype
                )
                if config.dense_normal_projection_enabled:
                    gradient = _project_gradient_to_sparse_normals(
                        gradient,
                        x_var,
                        eps=config.eps,
                    )
                if config.preserve_endpoint:
                    gradient = gradient.clone()
                    gradient[..., -1, :] = 0.0

                grad_norm = torch.linalg.vector_norm(
                    gradient.flatten(start_dim=-2), dim=-1
                )
                direction = gradient / grad_norm.clamp_min(
                    float(config.eps)
                )[..., None, None]
                active = (
                    peak_window
                    & (grad_norm > float(config.eps))
                    & peak_components["has_violation"]
                )

            if not bool(active.any().item()):
                break

            old_loss = peak_loss.detach()
            old_max = peak_max.detach()
            accepted_this = torch.zeros_like(active)
            step = torch.full_like(
                old_loss,
                float(config.dense_peak_recovery_step_m),
            )
            max_trials = (
                int(config.dense_backtracking_max_trials)
                if config.dense_backtracking_enabled else 1
            )

            for trial in range(max_trials):
                trial_active = active & ~accepted_this
                if not bool(trial_active.any().item()):
                    break

                candidate = current_xy - step[..., None, None] * direction.detach()
                # Reuse the G3 adaptive trust radius already assigned from the
                # original post-baseline hard-tail severity. This keeps G4 a
                # pure objective/acceptance change instead of another range sweep.
                delta = candidate - initial_xy
                total_move = torch.linalg.vector_norm(
                    delta.flatten(start_dim=-2), dim=-1
                )
                trust_scale = (
                    post_recovery_trust_limit
                    / total_move.clamp_min(float(config.eps))
                ).clamp(max=1.0)
                candidate = initial_xy + delta * trust_scale[..., None, None]
                if config.preserve_endpoint:
                    candidate = candidate.clone()
                    candidate[..., -1, :] = initial_xy[..., -1, :]

                with torch.no_grad():
                    cand_loss, cand_curvature, cand_valid, _ = evaluate(
                        candidate,
                        allow_input_gradient=False,
                        bound_weight=float(config.dense_peak_recovery_bound_weight),
                        peak_weight=float(config.dense_peak_recovery_peak_weight),
                        dkappa_weight=float(config.dense_peak_recovery_dkappa_weight),
                        peak_alpha=float(config.dense_peak_recovery_peak_alpha),
                    )
                    cand_max = torch.where(
                        cand_valid,
                        cand_curvature.abs(),
                        torch.zeros_like(cand_curvature),
                    ).amax(dim=-1)

                if config.dense_backtracking_enabled:
                    peak_improved = cand_max <= (
                        old_max
                        - float(config.dense_peak_recovery_min_peak_improvement)
                    )
                    peak_objective_nonincreasing = cand_loss <= (old_loss + 1.0e-8)
                    accept = (
                        trial_active
                        & peak_improved
                        & peak_objective_nonincreasing
                    )
                else:
                    accept = trial_active

                current_xy = torch.where(
                    accept[..., None, None], candidate, current_xy
                )
                accepted_this |= accept

                rejected = trial_active & ~accept
                if trial + 1 < max_trials:
                    peak_recovery_backtracking = (
                        peak_recovery_backtracking
                        + rejected.to(current_xy.dtype)
                    )
                    step = torch.where(
                        rejected,
                        step * float(config.dense_backtracking_factor),
                        step,
                    )
                    step = step.clamp_min(float(config.dense_min_step_m))

            peak_recovery_accepted = (
                peak_recovery_accepted
                + accepted_this.to(current_xy.dtype)
            )
            if not bool(accepted_this.any().item()):
                break

    peak_recovery_end_xy = current_xy.clone()

    # EXECUTION_CONSTRAINED_GUIDANCE_V4_0
    # B0/A/B/C comparison stage.  The anchor is the complete B0 output, so A,
    # B and C share one final-stage displacement budget and cannot gain merely
    # by stacking independent trust regions.
    constraint_anchor_xy = current_xy.clone()
    constraint_mode = str(config.dense_constraint_recovery_mode)
    zero_mode = torch.zeros(
        (batch, modes), device=current_xy.device, dtype=current_xy.dtype
    )
    alm_diag = {
        "trigger": torch.zeros_like(mode_valid),
        "start_max": zero_mode,
        "end_max": zero_mode,
        "accepted": zero_mode,
        "backtracking": zero_mode,
        "mean_lambda": torch.zeros((), device=current_xy.device, dtype=current_xy.dtype),
        "max_lambda": torch.zeros((), device=current_xy.device, dtype=current_xy.dtype),
    }
    projection_diag = {
        "trigger": torch.zeros_like(mode_valid),
        "start_max": zero_mode,
        "end_max": zero_mode,
        "accepted": zero_mode,
        "backtracking": zero_mode,
        "requested_step_sum": zero_mode,
    }

    if bool(allow_polish) and constraint_mode in {"alm", "hybrid"}:
        current_xy, alm_diag = _run_execution_alm_recovery(
            current_xy,
            anchor_xy=constraint_anchor_xy,
            mode_valid=mode_valid,
            config=config,
            evaluate_fn=evaluate,
        )
    if bool(allow_polish) and constraint_mode in {"projection", "hybrid"}:
        current_xy, projection_diag = _run_execution_projection_recovery(
            current_xy,
            anchor_xy=constraint_anchor_xy,
            mode_valid=mode_valid,
            config=config,
            evaluate_fn=evaluate,
        )
    constraint_end_xy = current_xy.clone()

    guided_xy = current_xy.detach()
    with torch.no_grad():
        loss_after, curvature_after, valid_after, components_after = evaluate(
            guided_xy,
            allow_input_gradient=False,
        )
        mode_count = mode_valid_f.sum(dim=-1).clamp_min(1.0)
        update_per_mode = torch.linalg.vector_norm(
            (guided_xy - initial_xy).flatten(start_dim=-2), dim=-1
        )
        loss_before_sample = (
            loss_before * mode_valid_f
        ).sum(dim=-1) / mode_count
        loss_after_sample = (
            loss_after * mode_valid_f
        ).sum(dim=-1) / mode_count
        update_l2_sample = (
            update_per_mode * mode_valid_f
        ).sum(dim=-1) / mode_count
        accepted_inner_sample = (
            accepted_inner * mode_valid_f
        ).sum(dim=-1) / mode_count
        backtracking_sample = (
            backtracking_reductions * mode_valid_f
        ).sum(dim=-1) / mode_count
        # DENSE_GUIDANCE_G2_ADAPTIVE_NORMAL_V3_3 diagnostics
        adaptive_normal_trigger_fraction = (
            (adaptive_tangent_weight_max > 0.0).to(current_xy.dtype)
            * mode_valid_f
        ).sum(dim=-1) / mode_count
        adaptive_normal_mean_tangent_weight = (
            adaptive_tangent_weight_max * mode_valid_f
        ).sum(dim=-1) / mode_count
        # DENSE_GUIDANCE_G1_POLISHING_V3_2 diagnostics
        polish_trigger_fraction = (
            polish_triggered.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / mode_count
        polish_iterations_sample = (
            polish_accepted * mode_valid_f
        ).sum(dim=-1) / mode_count
        polish_backtracking_sample = (
            polish_backtracking * mode_valid_f
        ).sum(dim=-1) / mode_count
        polish_update_per_mode = torch.linalg.vector_norm(
            (polish_end_xy - polish_start_xy).flatten(start_dim=-2), dim=-1
        )
        polish_update_sample = (
            polish_update_per_mode * mode_valid_f
        ).sum(dim=-1) / mode_count
        # DENSE_GUIDANCE_FSHARP_POST_RECOVERY_V3_4 + V3.5 cascade diagnostics
        post_recovery_trigger_fraction = (
            post_recovery_triggered.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / mode_count
        post_recovery_iterations_sample = (
            post_recovery_accepted * mode_valid_f
        ).sum(dim=-1) / mode_count
        post_recovery_backtracking_sample = (
            post_recovery_backtracking * mode_valid_f
        ).sum(dim=-1) / mode_count
        post_recovery_update_per_mode = torch.linalg.vector_norm(
            (post_recovery_end_xy - post_recovery_start_xy).flatten(start_dim=-2), dim=-1
        )
        post_recovery_update_sample = (
            post_recovery_update_per_mode * mode_valid_f
        ).sum(dim=-1) / mode_count
        post_recovery_total_move = torch.linalg.vector_norm(
            (post_recovery_end_xy - initial_xy).flatten(start_dim=-2), dim=-1
        )
        post_recovery_saturated = (
            post_recovery_triggered
            & (
                post_recovery_total_move
                >= post_recovery_trust_limit - 1.0e-4
            )
        )
        post_recovery_trigger_count = (
            post_recovery_triggered.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1).clamp_min(1.0)
        post_recovery_saturation_sample = (
            post_recovery_saturated.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / post_recovery_trigger_count
        post_recovery_tangent_weight_sample = (
            post_recovery_tangent_weight_max * mode_valid_f
        ).sum(dim=-1) / post_recovery_trigger_count
        post_recovery_trust_limit_sample = (
            post_recovery_trust_limit
            * post_recovery_triggered.to(current_xy.dtype)
            * mode_valid_f
        ).sum(dim=-1) / post_recovery_trigger_count

        _, post_recovery_end_curvature, post_recovery_end_valid, _ = evaluate(
            post_recovery_end_xy,
            allow_input_gradient=False,
        )
        post_recovery_end_max = torch.where(
            post_recovery_end_valid,
            post_recovery_end_curvature.abs(),
            torch.zeros_like(post_recovery_end_curvature),
        ).amax(dim=-1)
        post_recovery_to_polish = (
            post_recovery_triggered
            & (post_recovery_end_max > float(config.curvature_limit) + 1.0e-8)
            & (
                post_recovery_end_max
                <= float(config.dense_post_recovery_threshold) + 1.0e-8
            )
        )
        post_recovery_to_polish_sample = (
            post_recovery_to_polish.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / post_recovery_trigger_count

        second_polish_trigger_fraction = (
            second_polish_triggered.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / mode_count
        second_polish_iterations_sample = (
            second_polish_accepted * mode_valid_f
        ).sum(dim=-1) / mode_count
        second_polish_backtracking_sample = (
            second_polish_backtracking * mode_valid_f
        ).sum(dim=-1) / mode_count
        second_polish_update_per_mode = torch.linalg.vector_norm(
            (second_polish_end_xy - second_polish_start_xy).flatten(start_dim=-2), dim=-1
        )
        second_polish_update_sample = (
            second_polish_update_per_mode * mode_valid_f
        ).sum(dim=-1) / mode_count

        # DENSE_GUIDANCE_PEAK_RECOVERY_V3_6 diagnostics
        peak_recovery_trigger_fraction = (
            peak_recovery_triggered.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / mode_count
        peak_recovery_iterations_sample = (
            peak_recovery_accepted * mode_valid_f
        ).sum(dim=-1) / mode_count
        peak_recovery_backtracking_sample = (
            peak_recovery_backtracking * mode_valid_f
        ).sum(dim=-1) / mode_count
        peak_recovery_update_per_mode = torch.linalg.vector_norm(
            (peak_recovery_end_xy - peak_recovery_start_xy).flatten(start_dim=-2),
            dim=-1,
        )
        peak_recovery_update_sample = (
            peak_recovery_update_per_mode * mode_valid_f
        ).sum(dim=-1) / mode_count
        _, peak_recovery_end_curvature, peak_recovery_end_valid, _ = evaluate(
            peak_recovery_end_xy,
            allow_input_gradient=False,
        )
        peak_recovery_end_max = torch.where(
            peak_recovery_end_valid,
            peak_recovery_end_curvature.abs(),
            torch.zeros_like(peak_recovery_end_curvature),
        ).amax(dim=-1)
        peak_recovery_trigger_count = (
            peak_recovery_triggered.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1).clamp_min(1.0)
        peak_recovery_drop_sample = (
            (peak_recovery_start_max - peak_recovery_end_max).clamp_min(0.0)
            * peak_recovery_triggered.to(current_xy.dtype)
            * mode_valid_f
        ).sum(dim=-1) / peak_recovery_trigger_count
        peak_recovery_total_move = torch.linalg.vector_norm(
            (peak_recovery_end_xy - initial_xy).flatten(start_dim=-2), dim=-1
        )
        peak_recovery_saturated = (
            peak_recovery_triggered
            & (
                peak_recovery_total_move
                >= post_recovery_trust_limit - 1.0e-4
            )
        )
        peak_recovery_saturation_sample = (
            peak_recovery_saturated.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / peak_recovery_trigger_count


        # EXECUTION_CONSTRAINED_GUIDANCE_V4_0 diagnostics
        constraint_start_max, _, _ = _constraint_max_state(
            evaluate, constraint_anchor_xy
        )
        constraint_end_max, _, _ = _constraint_max_state(
            evaluate, constraint_end_xy
        )
        constraint_triggered = mode_valid & (
            constraint_start_max
            > float(config.dense_constraint_recovery_threshold) + 1.0e-8
        )
        constraint_trigger_count = (
            constraint_triggered.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1).clamp_min(1.0)
        constraint_trigger_fraction = (
            constraint_triggered.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / mode_count
        constraint_feasible_fraction = (
            (
                constraint_triggered
                & (constraint_end_max <= float(config.curvature_limit) + 1.0e-8)
            ).to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / constraint_trigger_count
        constraint_update_per_mode = torch.linalg.vector_norm(
            (constraint_end_xy - constraint_anchor_xy).flatten(start_dim=-2), dim=-1
        )
        constraint_update_sample = (
            constraint_update_per_mode * mode_valid_f
        ).sum(dim=-1) / mode_count
        constraint_drop_sample = (
            (constraint_start_max - constraint_end_max).clamp_min(0.0)
            * constraint_triggered.to(current_xy.dtype)
            * mode_valid_f
        ).sum(dim=-1) / constraint_trigger_count
        constraint_saturated = constraint_triggered & (
            constraint_update_per_mode
            >= float(config.dense_constraint_recovery_max_total_move_m) - 1.0e-4
        )
        constraint_saturation_sample = (
            constraint_saturated.to(current_xy.dtype) * mode_valid_f
        ).sum(dim=-1) / constraint_trigger_count
        alm_iterations_sample = (
            alm_diag["accepted"] * mode_valid_f
        ).sum(dim=-1) / mode_count
        alm_backtracking_sample = (
            alm_diag["backtracking"] * mode_valid_f
        ).sum(dim=-1) / mode_count
        projection_iterations_sample = (
            projection_diag["accepted"] * mode_valid_f
        ).sum(dim=-1) / mode_count
        projection_backtracking_sample = (
            projection_diag["backtracking"] * mode_valid_f
        ).sum(dim=-1) / mode_count
        projection_step_sample = (
            projection_diag["requested_step_sum"] * mode_valid_f
        ).sum(dim=-1) / mode_count
        alm_mean_lambda_sample = torch.full(
            (batch,), float(alm_diag["mean_lambda"].item()),
            device=current_xy.device, dtype=current_xy.dtype,
        )
        alm_max_lambda_sample = torch.full(
            (batch,), float(alm_diag["max_lambda"].item()),
            device=current_xy.device, dtype=current_xy.dtype,
        )

        valid_before_all = valid_before & mode_valid[..., None]
        valid_after_all = valid_after & mode_valid[..., None]
        max_before = torch.where(
            valid_before_all,
            curvature_before.abs(),
            torch.zeros_like(curvature_before),
        ).flatten(start_dim=1).amax(dim=-1)
        max_after = torch.where(
            valid_after_all,
            curvature_after.abs(),
            torch.zeros_like(curvature_after),
        ).flatten(start_dim=1).amax(dim=-1)

        def sample_component(name: str, source: dict[str, torch.Tensor]):
            return (source[name] * mode_valid_f).sum(dim=-1) / mode_count

        diagnostics = {
            "loss_before": loss_before_sample,
            "loss_after": loss_after_sample,
            "max_abs_curvature_before": max_before,
            "max_abs_curvature_after": max_after,
            "update_l2_m": update_l2_sample,
            "inner_iterations_used": accepted_inner_sample,
            "backtracking_reductions": backtracking_sample,
            # DENSE_GUIDANCE_G2_ADAPTIVE_NORMAL_V3_3
            "adaptive_normal_trigger_fraction": adaptive_normal_trigger_fraction,
            "adaptive_normal_mean_tangent_weight": adaptive_normal_mean_tangent_weight,
            # DENSE_GUIDANCE_G1_POLISHING_V3_2
            "polish_trigger_fraction": polish_trigger_fraction,
            "polish_iterations_used": polish_iterations_sample,
            "polish_backtracking_reductions": polish_backtracking_sample,
            "polish_update_l2_m": polish_update_sample,
            # DENSE_GUIDANCE_FSHARP_POST_RECOVERY_V3_4
            "post_recovery_trigger_fraction": post_recovery_trigger_fraction,
            "post_recovery_iterations_used": post_recovery_iterations_sample,
            "post_recovery_backtracking_reductions": post_recovery_backtracking_sample,
            "post_recovery_update_l2_m": post_recovery_update_sample,
            "post_recovery_trust_saturation_fraction": post_recovery_saturation_sample,
            # DENSE_GUIDANCE_CASCADE_RECOVERY_V3_5
            "post_recovery_mean_tangent_weight": post_recovery_tangent_weight_sample,
            "post_recovery_mean_trust_limit_m": post_recovery_trust_limit_sample,
            "post_recovery_to_polish_fraction": post_recovery_to_polish_sample,
            "second_polish_trigger_fraction": second_polish_trigger_fraction,
            "second_polish_iterations_used": second_polish_iterations_sample,
            "second_polish_backtracking_reductions": second_polish_backtracking_sample,
            "second_polish_update_l2_m": second_polish_update_sample,
            # DENSE_GUIDANCE_PEAK_RECOVERY_V3_6
            "peak_recovery_trigger_fraction": peak_recovery_trigger_fraction,
            "peak_recovery_iterations_used": peak_recovery_iterations_sample,
            "peak_recovery_backtracking_reductions": peak_recovery_backtracking_sample,
            "peak_recovery_update_l2_m": peak_recovery_update_sample,
            "peak_recovery_mean_max_curvature_drop": peak_recovery_drop_sample,
            "peak_recovery_trust_saturation_fraction": peak_recovery_saturation_sample,
            # EXECUTION_CONSTRAINED_GUIDANCE_V4_0
            "constraint_recovery_trigger_fraction": constraint_trigger_fraction,
            "constraint_recovery_final_feasible_fraction": constraint_feasible_fraction,
            "constraint_recovery_update_l2_m": constraint_update_sample,
            "constraint_recovery_mean_max_curvature_drop": constraint_drop_sample,
            "constraint_recovery_trust_saturation_fraction": constraint_saturation_sample,
            "alm_iterations_used": alm_iterations_sample,
            "alm_backtracking_reductions": alm_backtracking_sample,
            "alm_mean_lambda": alm_mean_lambda_sample,
            "alm_max_lambda": alm_max_lambda_sample,
            "projection_iterations_used": projection_iterations_sample,
            "projection_backtracking_reductions": projection_backtracking_sample,
            "projection_requested_step_m": projection_step_sample,
            "bound_loss_before": sample_component("bound_loss", components_before),
            "bound_loss_after": sample_component("bound_loss", components_after),
            "peak_loss_before": sample_component("peak_loss", components_before),
            "peak_loss_after": sample_component("peak_loss", components_after),
            "dkappa_loss_before": sample_component("dkappa_loss", components_before),
            "dkappa_loss_after": sample_component("dkappa_loss", components_after),
        }
        guided_norm = guided_xy / scale_xy
    return guided_norm, diagnostics

def apply_curvature_guidance(
    predicted_x0_norm: torch.Tensor,
    *,
    trajectory_scale: torch.Tensor,
    mode_valid_mask: torch.Tensor,
    config: SparseCurvatureGuidanceConfig,
    timestep: int,
    trajectory_spline=None,
    start_velocity_xy: Optional[torch.Tensor] = None,
    mode_features: Optional[torch.Tensor] = None,
    execution_residual_head=None,
    allow_polish: bool = True,
    allow_adaptive_normal: bool = True,
) -> tuple[torch.Tensor, Optional[dict[str, torch.Tensor]]]:
    if not config.applies_to(int(timestep)):
        return predicted_x0_norm, None
    if config.guidance_type == "sparse_curvature":
        return apply_sparse_curvature_guidance(
            predicted_x0_norm,
            trajectory_scale=trajectory_scale,
            mode_valid_mask=mode_valid_mask,
            config=config,
            timestep=timestep,
        )
    if config.guidance_type == "dense_curvature":
        if trajectory_spline is None or start_velocity_xy is None:
            raise ValueError(
                "dense_curvature guidance requires trajectory_spline and "
                "start_velocity_xy"
            )
        return apply_dense_curvature_guidance(
            predicted_x0_norm,
            trajectory_scale=trajectory_scale,
            mode_valid_mask=mode_valid_mask,
            config=config,
            timestep=timestep,
            trajectory_spline=trajectory_spline,
            start_velocity_xy=start_velocity_xy,
            mode_features=mode_features,
            execution_residual_head=execution_residual_head,
                   allow_polish=allow_polish,  # DENSE_GUIDANCE_G1_FINAL_STEP_ONLY_V3_2_1
                   allow_adaptive_normal=allow_adaptive_normal,  # DENSE_GUIDANCE_G2_1_FINAL_STEP_ONLY_V3_3_1
        )
    return predicted_x0_norm, None
