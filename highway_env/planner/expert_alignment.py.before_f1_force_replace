from __future__ import annotations

from typing import Dict, Sequence
import numpy as np

from highway_env.planner.mode_definitions import MODE_NAMES, MODE_SLOTS

STRATEGY_NAMES = (
    "valid_any",
    "geometry_any",
    "valid_semantic",
    "geometry_semantic",
)


def _semantic_of_mode(mode_idx: int) -> str:
    try:
        return str(MODE_SLOTS[int(mode_idx)].semantic_group)
    except Exception:
        i = int(mode_idx)
        if 0 <= i <= 2:
            return "KEEP"
        if 3 <= i <= 5:
            return "LEFT_LC"
        if 6 <= i <= 8:
            return "RIGHT_LC"
        if i == 9:
            return "STOP"
        return "UNKNOWN"


class ExpertTrajectoryAligner:
    """F.1 expert/Dynamic-Anchor alignment diagnostics."""

    def align_batch(
        self,
        *,
        features: Dict[str, np.ndarray],
        expert_xy: np.ndarray,
        trajectory_time_s: np.ndarray,
        current_lane_indices: Sequence,
        target_lane_indices: Sequence,
    ) -> Dict[str, object]:
        anchors = np.asarray(features["coarse_trajectories"], dtype=np.float32)
        valid_mask = np.asarray(features["mode_valid_mask"], dtype=bool)
        expert_xy = np.asarray(expert_xy, dtype=np.float32)
        trajectory_time_s = np.asarray(trajectory_time_s, dtype=np.float32)

        if anchors.ndim != 4:
            raise ValueError("coarse_trajectories must be [B,M,T,2]")
        B, M, T, D = anchors.shape
        if D != 2 or expert_xy.shape != (B, T, 2):
            raise ValueError("trajectory shape mismatch")
        if valid_mask.shape != (B, M):
            raise ValueError("mode_valid_mask shape mismatch")
        if trajectory_time_s.shape != (T,):
            raise ValueError("trajectory_time_s shape mismatch")

        geometry_mask = np.any(np.abs(anchors) > 1e-6, axis=(2, 3))

        residual_all = expert_xy[:, None, :, :] - anchors
        point_error_all = np.linalg.norm(residual_all, axis=-1)

        mode_mse = ((anchors - expert_xy[:, None, :, :]) ** 2).mean(axis=(2, 3)).astype(np.float32)
        mode_ade = point_error_all.mean(axis=-1).astype(np.float32)
        mode_fde = point_error_all[:, :, -1].astype(np.float32)
        mode_max_abs_dx = np.abs(residual_all[:, :, :, 0]).max(axis=-1).astype(np.float32)
        mode_max_abs_dy = np.abs(residual_all[:, :, :, 1]).max(axis=-1).astype(np.float32)

        expected_groups = tuple(
            self._expected_semantic_group(cur, tgt)
            for cur, tgt in zip(current_lane_indices, target_lane_indices)
        )
        mode_groups = tuple(_semantic_of_mode(i) for i in range(M))

        semantic_mask = np.zeros((B, M), dtype=bool)
        for b in range(B):
            for m in range(M):
                semantic_mask[b, m] = mode_groups[m] == expected_groups[b]

        masks = {
            "valid_any": valid_mask.copy(),
            "geometry_any": geometry_mask.copy(),
            "valid_semantic": valid_mask & semantic_mask,
            "geometry_semantic": geometry_mask & semantic_mask,
        }

        strategies = {
            name: self._select(
                name=name,
                candidate_mask=masks[name],
                anchors=anchors,
                mode_mse=mode_mse,
                mode_ade=mode_ade,
                mode_fde=mode_fde,
                mode_max_abs_dx=mode_max_abs_dx,
                mode_max_abs_dy=mode_max_abs_dy,
                residual_all=residual_all,
                mode_groups=mode_groups,
                expected_groups=expected_groups,
            )
            for name in STRATEGY_NAMES
        }

        # Backward-compatible aliases: preserve the previous current rule.
        current = strategies["valid_any"]

        return {
            "expert_trajectory_xy": expert_xy.copy(),
            "trajectory_time_s": trajectory_time_s.copy(),
            "geometry_mask": geometry_mask.copy(),
            "mode_valid_mask": valid_mask.copy(),
            "semantic_mask": semantic_mask.copy(),
            "mode_semantic_group": mode_groups,
            "expected_semantic_group": expected_groups,
            "mode_mse": mode_mse,
            "mode_ade": mode_ade,
            "mode_fde": mode_fde,
            "mode_max_abs_dx": mode_max_abs_dx,
            "mode_max_abs_dy": mode_max_abs_dy,
            "residual_xy_all": residual_all.astype(np.float32),
            "candidate_masks": masks,
            "strategies": strategies,
            "nearest_anchor_xy": current["selected_anchor_xy"].copy(),
            "nearest_mode_idx": current["mode_idx"].copy(),
            "nearest_mode_name": current["mode_name"],
            "nearest_semantic_group": current["semantic_group"],
            "semantic_match": current["semantic_match"].copy(),
            "nearest_anchor_ade": current["ade"].copy(),
            "nearest_anchor_fde": current["fde"].copy(),
            "max_abs_dx": current["max_abs_dx"].copy(),
            "max_abs_dy": current["max_abs_dy"].copy(),
            "residual_xy": current["residual_xy"].copy(),
        }

    def _select(
        self,
        *,
        name,
        candidate_mask,
        anchors,
        mode_mse,
        mode_ade,
        mode_fde,
        mode_max_abs_dx,
        mode_max_abs_dy,
        residual_all,
        mode_groups,
        expected_groups,
    ):
        B, _ = candidate_mask.shape
        T = anchors.shape[2]

        idx = np.full(B, -1, dtype=np.int64)
        selected_anchor = np.full((B, T, 2), np.nan, dtype=np.float32)
        selected_residual = np.full((B, T, 2), np.nan, dtype=np.float32)
        mse = np.full(B, np.nan, dtype=np.float32)
        ade = np.full(B, np.nan, dtype=np.float32)
        fde = np.full(B, np.nan, dtype=np.float32)
        max_dx = np.full(B, np.nan, dtype=np.float32)
        max_dy = np.full(B, np.nan, dtype=np.float32)
        names, groups = [], []
        sem_match = np.zeros(B, dtype=bool)

        for b in range(B):
            candidates = np.flatnonzero(candidate_mask[b])
            if candidates.size == 0:
                names.append("NONE")
                groups.append("NONE")
                continue

            m = int(candidates[np.argmin(mode_mse[b, candidates])])
            idx[b] = m
            selected_anchor[b] = anchors[b, m]
            selected_residual[b] = residual_all[b, m]
            mse[b] = mode_mse[b, m]
            ade[b] = mode_ade[b, m]
            fde[b] = mode_fde[b, m]
            max_dx[b] = mode_max_abs_dx[b, m]
            max_dy[b] = mode_max_abs_dy[b, m]
            names.append(MODE_NAMES[m])
            groups.append(mode_groups[m])
            sem_match[b] = mode_groups[m] == expected_groups[b]

        return {
            "name": name,
            "candidate_mask": candidate_mask.copy(),
            "candidate_count": candidate_mask.sum(axis=1).astype(np.int64),
            "mode_idx": idx,
            "mode_name": tuple(names),
            "semantic_group": tuple(groups),
            "semantic_match": sem_match,
            "mse": mse,
            "ade": ade,
            "fde": fde,
            "max_abs_dx": max_dx,
            "max_abs_dy": max_dy,
            "selected_anchor_xy": selected_anchor,
            "residual_xy": selected_residual,
        }

    @staticmethod
    def _lane_id(lane_index) -> int:
        try:
            return int(lane_index[2])
        except Exception as exc:
            raise ValueError(f"Unsupported lane index: {lane_index!r}") from exc

    def _expected_semantic_group(self, current_lane_index, target_lane_index) -> str:
        current_id = self._lane_id(current_lane_index)
        target_id = self._lane_id(target_lane_index)
        if target_id == current_id:
            return "KEEP"
        if target_id < current_id:
            return "LEFT_LC"
        return "RIGHT_LC"
