                f"{training_log_dir}"
            )

        plot_ade_fde_boxplot(
            rows,
            figure_dir / "01_ade_fde_boxplot.png",
        )
        plot_random_trajectory_gallery(
            gallery_samples,
            figure_dir / "02_random_trajectory_gallery_3x3.png",
