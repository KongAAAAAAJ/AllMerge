            finite_metric_check(metrics)

            # OPEN_LOOP_DENSE_RESIDUAL_EVAL_V1
            dense_metrics = _dense_execution_metrics(
                model=model,
                output=output,
                features=features,
                expert_sparse=expert_trajectory,
                expert_dense=expert_trajectory_dense,
