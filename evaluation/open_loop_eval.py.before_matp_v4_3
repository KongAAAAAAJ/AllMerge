        float(
            sum(execution_collision_flags)
            / len(execution_collision_flags)
        )
        if execution_collision_flags
        else float("nan")
    )
    execution_offroad_rate = (
        float(
            sum(execution_offroad_flags)
            / len(execution_offroad_flags)
        )
        if execution_offroad_flags
        else float("nan")
    )
