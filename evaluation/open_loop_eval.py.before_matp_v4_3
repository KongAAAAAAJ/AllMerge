    rows: List[dict] = []
    batch_latencies_ms: List[float] = []
    collision_flags: List[bool] = []
    offroad_flags: List[bool] = []
    # BASE_DENSE_SAFETY_PROXY_V1
    base_dense_collision_flags: List[bool] = []
    base_dense_offroad_flags: List[bool] = []
