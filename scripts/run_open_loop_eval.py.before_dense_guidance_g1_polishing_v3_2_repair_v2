from __future__ import annotations

# ROAD_OUTER_BOUNDARY_OFFROAD_V1

import argparse
import sys
from pathlib import Path

# Make repo-root packages importable when invoked as:
#   python scripts/run_open_loop_eval.py ...
REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from evaluation.open_loop_eval import (  # noqa: E402
    evaluate_open_loop,
    print_summary,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "AllMerge W5 pretrained Diffusion "
            "open-loop evaluation"
        )
    )
    parser.add_argument(
        "--checkpoint",
        type=Path,
        default="all_merge\\outputs\\diffusion_pretrain_50k\\run_1\\checkpoints\\best.pt",
    )
    parser.add_argument(
        "--dataset-root",
        type=Path,
        default="all_merge\\outputs\\expert_dataset\\allmerge_expert_50k",
    )
    parser.add_argument(
        "--split",
        choices=[
            "all",
            "train",
            "val",
            "test",
        ],
        default="val",
    )
    parser.add_argument(
        "--output-csv",
        type=Path,
        default=Path(
            "outputs/evaluation/"
            "open_loop_results.csv"
        ),
    )
    parser.add_argument(
        "--batch-size",
        type=int,
        default=32,
    )
    parser.add_argument(
        "--num-workers",
        type=int,
        default=0,
    )
    parser.add_argument(
        "--limit-samples",
        type=int,
        default=0,
    )
    parser.add_argument(
        "--device",
        type=str,
        default=None,
    )
    parser.add_argument(
        "--inference-seed",
        type=int,
        default=0,
        help=(
            "Deterministic diffusion sampling seed. "
            "Use the same value for checkpoint comparisons."
        ),
    )
    parser.add_argument(
        "--strict-checkpoint",
        action="store_true",
    )
    # EVAL_VIZ_V2_CLI
    parser.add_argument(
        "--no-visualization",
        action="store_true",
        help="Disable PNG/summary-table generation.",
    )
    parser.add_argument(
        "--figure-dir",
        type=Path,
        default=None,
        help="Default: <output-csv parent>/figures",
    )
    parser.add_argument(
        "--visualization-seed",
        type=int,
        default=None,
        help=(
            "Seed for the random 9-sample gallery. "
            "Default None changes samples each run."
        ),
    )
    parser.add_argument(
        "--initial-checkpoint",
        type=Path,
        default=None,
        help=(
            "Training-start checkpoint for the 1x2 same-noise comparison. "
            "Default: <checkpoint parent>/initial.pt"
        ),
    )
    parser.add_argument(
        "--miss-threshold-m",
        type=float,
        default=2.0,
    )
    parser.add_argument(
        "--collision-distance-m",
        type=float,
        default=2.5,
        help="Open-loop static-agent collision proxy distance.",
    )
    parser.add_argument(
        "--offroad-margin-m",
        "--offroad-distance-m",
        dest="offroad_distance_m",
        type=float,
        default=0.0,
        help=(
            "Optional margin outside the represented road outer boundary. "
            "Off-road uses the union of lane-width ribbons. Default: 0.0 m. "
            "The old --offroad-distance-m spelling remains as an alias."
        ),
    )
    # SPARSE_CURVATURE_GUIDANCE_V1
    parser.add_argument(
        "--guidance-enabled",
        action="store_true",
        help="Enable inference-time sparse curvature guidance.",
    )
    parser.add_argument(
        "--guidance-scale",
        type=float,
        default=0.05,
        help="Guidance gradient step scale.",
    )
    parser.add_argument(
        "--guidance-curvature-limit",
        type=float,
        default=0.02,
        help="Sparse trajectory curvature limit in 1/m.",
    )
    parser.add_argument(
        "--guidance-grad-clip-norm",
        type=float,
        default=1.0,
        help="Guidance gradient norm clip.",
    )
    parser.add_argument(
        "--guidance-timesteps",
        type=str,
        default="all",
        help='Comma-separated reverse steps, e.g. "8,0"; default all.',
    )
    parser.add_argument(
        "--guidance-allow-endpoint-move",
        action="store_true",
        help="Allow guidance to move the final sparse waypoint.",
    )
    # DENSE_CURVATURE_GUIDANCE_V1_REPAIR
    parser.add_argument(
        "--guidance-type",
        choices=("sparse_curvature", "dense_curvature"),
        default="sparse_curvature",
        help="Curvature source for inference-time guidance.",
    )
    parser.add_argument(
        "--guidance-dense-min-speed-mps",
        type=float,
        default=0.5,
        help="Ignore dense spline curvature below this speed (m/s).",
    )
    # DENSE_CURVATURE_GUIDANCE_V2
    parser.add_argument(
        "--guidance-dense-step-m",
        type=float,
        default=0.20,
        help="Normalized dense-guidance step length in metres per reverse step.",
    )
    parser.add_argument(
        "--guidance-dense-topk-fraction",
        type=float,
        default=0.20,
        help="Fraction of valid dense curvature points used by top-k loss.",
    )
    parser.add_argument(
        "--guidance-dense-min-segment-m",
        type=float,
        default=0.25,
        help="Minimum adjacent/chord length for geometric dense curvature.",
    )
    # DENSE_CURVATURE_GUIDANCE_V3
    parser.add_argument("--guidance-dense-inner-iters", type=int, default=5)
    parser.add_argument("--guidance-dense-no-backtracking", action="store_true")
    parser.add_argument("--guidance-dense-backtracking-factor", type=float, default=0.5)
    parser.add_argument("--guidance-dense-backtracking-max-trials", type=int, default=4)
    parser.add_argument("--guidance-dense-min-step-m", type=float, default=0.025)
    parser.add_argument("--guidance-dense-max-total-move-m", type=float, default=0.50)
    parser.add_argument("--guidance-dense-bound-weight", type=float, default=1.0)
    parser.add_argument("--guidance-dense-peak-weight", type=float, default=0.5)
    parser.add_argument("--guidance-dense-dkappa-weight", type=float, default=0.1)
    parser.add_argument("--guidance-dense-peak-alpha", type=float, default=10.0)
    parser.add_argument("--guidance-dense-stop-residual-gradient", action="store_true")
    parser.add_argument("--guidance-dense-no-normal-projection", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    guidance_text = str(args.guidance_timesteps).strip().lower()
    guidance_timesteps = (
        None
        if guidance_text in {"", "all", "none"}
        else tuple(
            int(item.strip())
            for item in guidance_text.split(",")
            if item.strip()
        )
    )
    summary = evaluate_open_loop(
        checkpoint=args.checkpoint,
        dataset_root=args.dataset_root,
        split=args.split,
        output_csv=args.output_csv,
        batch_size=args.batch_size,
        num_workers=args.num_workers,
        limit_samples=args.limit_samples,
        device=args.device,
        inference_seed=args.inference_seed,
        strict_checkpoint=args.strict_checkpoint,
        visualize=not args.no_visualization,
        figure_dir=args.figure_dir,
        visualization_seed=args.visualization_seed,
        initial_checkpoint=args.initial_checkpoint,
        miss_threshold_m=args.miss_threshold_m,
        collision_distance_m=args.collision_distance_m,
        offroad_distance_m=args.offroad_distance_m,
        # SPARSE_CURVATURE_GUIDANCE_V1
        guidance_enabled=args.guidance_enabled,
        guidance_scale=args.guidance_scale,
        guidance_curvature_limit=args.guidance_curvature_limit,
        guidance_grad_clip_norm=args.guidance_grad_clip_norm,
        guidance_timesteps=guidance_timesteps,
        guidance_preserve_endpoint=not args.guidance_allow_endpoint_move,
        # DENSE_CURVATURE_GUIDANCE_V1_REPAIR
        guidance_type=args.guidance_type,
        guidance_dense_min_speed_mps=args.guidance_dense_min_speed_mps,
        # DENSE_CURVATURE_GUIDANCE_V2
        guidance_dense_step_m=args.guidance_dense_step_m,
        guidance_dense_topk_fraction=args.guidance_dense_topk_fraction,
        guidance_dense_min_segment_m=args.guidance_dense_min_segment_m,
        guidance_dense_inner_iters=args.guidance_dense_inner_iters,
        guidance_dense_backtracking_enabled=not args.guidance_dense_no_backtracking,
        guidance_dense_backtracking_factor=args.guidance_dense_backtracking_factor,
        guidance_dense_backtracking_max_trials=args.guidance_dense_backtracking_max_trials,
        guidance_dense_min_step_m=args.guidance_dense_min_step_m,
        guidance_dense_max_total_move_m=args.guidance_dense_max_total_move_m,
        guidance_dense_bound_weight=args.guidance_dense_bound_weight,
        guidance_dense_peak_weight=args.guidance_dense_peak_weight,
        guidance_dense_dkappa_weight=args.guidance_dense_dkappa_weight,
        guidance_dense_peak_alpha=args.guidance_dense_peak_alpha,
        guidance_dense_residual_gradient_enabled=not args.guidance_dense_stop_residual_gradient,
        guidance_dense_normal_projection_enabled=not args.guidance_dense_no_normal_projection,
    )
    print_summary(summary)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
