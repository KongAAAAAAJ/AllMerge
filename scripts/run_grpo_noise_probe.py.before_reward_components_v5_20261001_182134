    HybridProbeGroupDiffusionSampler,
    MultiplicativeProbeGroupDiffusionSampler,
)
from highway_env.planner.diffusion.structured_model import StructuredDiffusionPlanner
from highway_env.planner.diffusion.tensor_adapter import BOOL_KEYS, FLOAT_KEYS, PlannerTensorAdapter


FEATURE_KEYS = (*FLOAT_KEYS, *BOOL_KEYS)
SCENARIOS = {
    "straight": StraightLaneChangeEnv,
    "curved": CurvedLaneChangeEnv,
    "merge_in": MergeInEnv,
    "merge_out": MergeOutEnv,
}


@dataclass(frozen=True)
class CheckpointSpec:
    name: str
    path: Path


@dataclass
class GalleryState:
    checkpoint: str
    scenario: str
    sample_index: int
    env_seed: int
    noise_seed: int
    vehicle_role: int
    mode: int
    trajectories: np.ndarray  # [G,H,2]
    rewards: np.ndarray       # [G]


@dataclass(frozen=True)
class SelectedModeSummary:
    checkpoint: str
    scenario: str
    sample_index: int
    env_seed: int
    noise_seed: int
    noise_type: str
    multiplicative_std: float
    hybrid_multiplicative_x_std: float
    hybrid_additive_y_std_m: float
    vehicle_role: int
    mode: int
    group_size: int
    group0_reward: float
    best_reward: float
    best_group_id: int
    best_gain: float
    reward_mean: float
    reward_range: float
    reward_std: float
    best_minus_mean: float
    sparse_pairwise_ade_mean: float
    sparse_pairwise_abs_dx_mean: float
    sparse_pairwise_abs_dy_mean: float
    sparse_endpoint_dx_std: float
    sparse_endpoint_dy_std: float


def _parse_checkpoint(value: str) -> CheckpointSpec:
    name, sep, raw_path = value.partition("=")
    if not sep:
        path = Path(value)
        name = path.parent.parent.parent.name or path.stem
    else:
        name = name.strip()
        path = Path(raw_path.strip())
    if not name:
        raise argparse.ArgumentTypeError("checkpoint name cannot be empty")
    return CheckpointSpec(name=name, path=path)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Probe current GRPO group sampling without training. For each fixed "
            "environment state, generate G trajectories from different diffusion "
            "noise, score them with the production W4 reward, and compare every "
            "group against group 0. V4 supports additive, multiplicative, and hybrid "
            "x-multiplicative/y-additive reverse-transition exploration, "
            "selected-mode x/y diversity diagnostics, and the existing random "
            "3x3 trajectory gallery."
        )
    )
    parser.add_argument("--checkpoint", action="append", type=_parse_checkpoint, required=True)
    parser.add_argument("--scenario", choices=("all", *SCENARIOS.keys()), default="all")
    parser.add_argument("--samples-per-scenario", type=int, default=25)
    parser.add_argument("--group-size", type=int, default=48)
    parser.add_argument("--eta", type=float, default=0.02)
    parser.add_argument(
        "--noise-type",
        choices=("additive", "multiplicative", "hybrid"),
        default="additive",
        help=(
            "reverse-transition exploration type. additive uses the existing GRPO "
            "sampler; multiplicative uses shared x/y scale factors; hybrid keeps "
            "longitudinal x multiplicative while adding a horizon-ramped lateral "
            "y offset in meters. Anchor and initial forward noising stay unchanged."
        ),
    )
    parser.add_argument(
        "--multiplicative-std",
        type=float,
        default=0.04,
        help=(
            "std of epsilon in prev_sample = prev_sample_mean * (1 + epsilon_xy) "
            "for multiplicative probe sampling; ignored for additive"
        ),
    )
    parser.add_argument(
        "--hybrid-multiplicative-x-std",
        type=float,
        default=0.12,
        help=(
            "longitudinal multiplicative std for hybrid sampling; x is scaled as "
            "x * (1 + eps_x). Default 0.12."
        ),
    )
    parser.add_argument(
        "--hybrid-additive-y-std-m",
        type=float,
        default=0.50,
        help=(
            "4-second endpoint lateral additive-noise std in meters for hybrid "
            "sampling. The offset is linearly ramped over the trajectory horizon."
        ),
    )
    parser.add_argument("--group-action", type=int, default=3)
    parser.add_argument("--seed", type=int, default=7, help="base environment seed")
    parser.add_argument(
        "--noise-seed", type=int, default=700000,
        help="base seed for diffusion group sampling; shared across checkpoints",
    )
    parser.add_argument("--improvement-eps", type=float, default=DEFAULT_IMPROVEMENT_EPS)
    parser.add_argument(
        "--max-seed-attempts", type=int, default=1000,
        help="maximum deterministic seed attempts per scenario to collect valid states",
    )
    parser.add_argument("--reward-fn", default="auto")
    parser.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    parser.add_argument("--output-dir", type=Path, default=Path("outputs/grpo_noise_probe_100ep_v4"))
    parser.add_argument(
        "--visualization-seed", type=int, default=0,
        help="deterministic seed used to choose random gallery states",
    )
    parser.add_argument(
        "--gallery-count", type=int, default=9,
        help="number of random states per checkpoint in the trajectory gallery; default 9",
    )
    parser.add_argument(
        "--gallery-vehicle-role", type=int, default=0, choices=(0, 1, 2),
        help="controlled vehicle role visualized in the 3x3 gallery",
    )
    parser.add_argument("--no-plots", action="store_true", help="skip all matplotlib plots")
    return parser.parse_args()


def _scenario_features(env: object, adapter: PlannerTensorAdapter) -> Dict[str, torch.Tensor]:
    values = getattr(env, "latest_planner_features", None)
    if values is None:
        raise RuntimeError(
            "scenario did not expose latest_planner_features; call env.step(group_action) first"
        )
    missing = [key for key in FEATURE_KEYS if key not in values]
    if missing:
        raise RuntimeError(f"latest_planner_features missing keys: {missing}")
    return adapter.to_torch({key: values[key] for key in FEATURE_KEYS})


def _frozen_reward_context(
    model: StructuredDiffusionPlanner,
    features: Dict[str, torch.Tensor],
    env: object,
) -> tuple[GRPORewardContext, torch.Tensor]:
    model.eval()
    with torch.no_grad():
        frozen = model.infer_multimodal(features)
    context = GRPORewardContext(
        env=env,
        frozen_all_mode_trajectories=frozen["trajectory_candidates"],
        frozen_argmax_joint_trajectories=frozen["trajectory"],
        valid_mode_mask=features["mode_valid_mask"],
    )
    selected_mode_idx = frozen["trajectory_mode_idx"].detach()
    return context, selected_mode_idx


def _scenario_order(args: argparse.Namespace) -> list[str]:
    return list(SCENARIOS.keys()) if args.scenario == "all" else [str(args.scenario)]


def _state_seed(base_seed: int, scenario_index: int, attempt_index: int) -> int:
    return int(base_seed + scenario_index * 100000 + attempt_index)


def _sample_noise_seed(base_seed: int, scenario_index: int, sample_index: int) -> int:
    return int(base_seed + scenario_index * 100000 + sample_index)


def _build_model(checkpoint: CheckpointSpec, device: torch.device):
    config = StructuredDiffusionConfig()
    adapter = PlannerTensorAdapter(config, device)
    model = StructuredDiffusionPlanner(config, adapter).to(device)
    load_info = load_pretrained(model, checkpoint.path, strict=True)
    model.eval()
    model.requires_grad_(False)
    print(f"[checkpoint] name={checkpoint.name} path={checkpoint.path}")
    print(f"[checkpoint] strict load: {load_info}")
    return adapter, model


def _gallery_state(
    *,
    checkpoint: str,
    scenario: str,
    sample_index: int,
    env_seed: int,
    noise_seed: int,
    vehicle_role: int,
    selected_mode_idx: torch.Tensor,
    candidates: torch.Tensor,
    rewards: torch.Tensor,
) -> GalleryState:
    mode = int(selected_mode_idx[vehicle_role].detach().cpu().item())
    trajectories = candidates[vehicle_role, :, mode].detach().cpu().numpy().astype(np.float32)
    reward_values = rewards[vehicle_role, :, mode].detach().cpu().numpy().astype(np.float32)
    return GalleryState(
        checkpoint=checkpoint,
        scenario=scenario,
        sample_index=int(sample_index),
        env_seed=int(env_seed),
        noise_seed=int(noise_seed),
        vehicle_role=int(vehicle_role),
        mode=mode,
        trajectories=trajectories,
        rewards=reward_values,
    )



def _selected_mode_stats(
    *,
    checkpoint: str,
    scenario: str,
    sample_index: int,
    env_seed: int,
    noise_seed: int,
    noise_type: str,
    multiplicative_std: float,
    hybrid_multiplicative_x_std: float,
    hybrid_additive_y_std_m: float,
    selected_mode_idx: torch.Tensor,
    candidates: torch.Tensor,
    rewards: torch.Tensor,
) -> list[SelectedModeSummary]:
    """Measure the actual model-selected mode instead of averaging all valid modes."""
    rows: list[SelectedModeSummary] = []
    candidate_np = candidates.detach().cpu().numpy().astype(np.float64)
    reward_np = rewards.detach().cpu().numpy().astype(np.float64)
    selected_np = selected_mode_idx.detach().cpu().numpy().reshape(-1)

    for role in range(candidate_np.shape[0]):
        mode = int(selected_np[role])
        traj = candidate_np[role, :, mode]  # [G,H,2]
        r = reward_np[role, :, mode]        # [G]
        group_size = int(traj.shape[0])

        delta = traj[:, None, :, :] - traj[None, :, :, :]
        iu = np.triu_indices(group_size, k=1)
        pairwise_ade = np.linalg.norm(delta, axis=-1).mean(axis=-1)[iu]
        pairwise_abs_dx = np.abs(delta[..., 0]).mean(axis=-1)[iu]
        pairwise_abs_dy = np.abs(delta[..., 1]).mean(axis=-1)[iu]

        endpoint = traj[:, -1, :]
        best_group = int(np.argmax(r))
        best_reward = float(r[best_group])
        reward_mean = float(np.mean(r))

        rows.append(
            SelectedModeSummary(
                checkpoint=checkpoint,
                scenario=scenario,
                sample_index=int(sample_index),
                env_seed=int(env_seed),
                noise_seed=int(noise_seed),
                noise_type=str(noise_type),
                multiplicative_std=float(multiplicative_std),
                hybrid_multiplicative_x_std=float(hybrid_multiplicative_x_std),
                hybrid_additive_y_std_m=float(hybrid_additive_y_std_m),
                vehicle_role=int(role),
                mode=mode,
                group_size=group_size,
                group0_reward=float(r[0]),
                best_reward=best_reward,
                best_group_id=best_group,
                best_gain=float(best_reward - r[0]),
                reward_mean=reward_mean,
                reward_range=float(np.max(r) - np.min(r)),
                reward_std=float(np.std(r)),
                best_minus_mean=float(best_reward - reward_mean),
                sparse_pairwise_ade_mean=float(np.mean(pairwise_ade)),
                sparse_pairwise_abs_dx_mean=float(np.mean(pairwise_abs_dx)),
                sparse_pairwise_abs_dy_mean=float(np.mean(pairwise_abs_dy)),
                sparse_endpoint_dx_std=float(np.std(endpoint[:, 0])),
                sparse_endpoint_dy_std=float(np.std(endpoint[:, 1])),
            )
        )
    return rows


def _aggregate_selected_mode(
    rows: list[SelectedModeSummary],
    *,
    checkpoint: str,
    scenario: str,
) -> dict[str, object]:
    subset = [
        row for row in rows
        if row.checkpoint == checkpoint and (scenario == "all" or row.scenario == scenario)
    ]
    if not subset:
        raise ValueError(
            f"no selected-mode rows for checkpoint={checkpoint} scenario={scenario}"
        )

    def mean(field: str) -> float:
        return float(np.mean([float(getattr(row, field)) for row in subset]))

    return {
        "checkpoint": checkpoint,
        "scenario": scenario,
        "noise_type": subset[0].noise_type,
        "multiplicative_std": float(subset[0].multiplicative_std),
        "hybrid_multiplicative_x_std": float(subset[0].hybrid_multiplicative_x_std),
        "hybrid_additive_y_std_m": float(subset[0].hybrid_additive_y_std_m),
        "selected_vehicle_mode_count": len(subset),
        "group_size": int(subset[0].group_size),
        "mean_selected_pairwise_ADE": mean("sparse_pairwise_ade_mean"),
        "mean_selected_pairwise_abs_dx": mean("sparse_pairwise_abs_dx_mean"),
        "mean_selected_pairwise_abs_dy": mean("sparse_pairwise_abs_dy_mean"),
        "mean_selected_endpoint_dx_std": mean("sparse_endpoint_dx_std"),
        "mean_selected_endpoint_dy_std": mean("sparse_endpoint_dy_std"),
        "mean_selected_reward_std": mean("reward_std"),
        "mean_selected_reward_range": mean("reward_range"),
        "mean_selected_best_gain": mean("best_gain"),
        "mean_selected_best_minus_mean": mean("best_minus_mean"),
        "mean_selected_group0_reward": mean("group0_reward"),
        "mean_selected_best_reward": mean("best_reward"),
    }



def _run_checkpoint(
    args: argparse.Namespace,
    checkpoint: CheckpointSpec,
    *,
    device: torch.device,
) -> tuple[
    list[ProbeSampleSummary],
    list[ProbeGroupSummary],
    list[ProbeVehicleModeSummary],
    list[SelectedModeSummary],
    list[GalleryState],
]:
    adapter, model = _build_model(checkpoint, device)
    if args.noise_type == "additive":
        sampler = GroupDiffusionSampler(
            model,
            group_size=int(args.group_size),
            eta=float(args.eta),
        )
    elif args.noise_type == "multiplicative":
        sampler = MultiplicativeProbeGroupDiffusionSampler(
            model,
            group_size=int(args.group_size),
            eta=float(args.eta),
            multiplicative_std=float(args.multiplicative_std),
        )
    else:
        sampler = HybridProbeGroupDiffusionSampler(
            model,
            group_size=int(args.group_size),
            eta=float(args.eta),
            multiplicative_x_std=float(args.hybrid_multiplicative_x_std),
            additive_y_std_m=float(args.hybrid_additive_y_std_m),
        )
    reward_adapter = CandidateRewardAdapter(resolve_reward_evaluator(args.reward_fn))

    sample_rows: list[ProbeSampleSummary] = []
    group_rows: list[ProbeGroupSummary] = []
    vm_rows: list[ProbeVehicleModeSummary] = []
    selected_rows: list[SelectedModeSummary] = []
    gallery_rows: list[GalleryState] = []

    scenarios = _scenario_order(args)
    for scenario_index, scenario_name in enumerate(scenarios):
        env_cls = SCENARIOS[scenario_name]
        collected = 0
        attempts = 0
        while collected < int(args.samples_per_scenario):
            if attempts >= int(args.max_seed_attempts):
                raise RuntimeError(
                    f"could not collect {args.samples_per_scenario} valid states for "
                    f"scenario={scenario_name} within {args.max_seed_attempts} attempts"
                )

            env_seed = _state_seed(args.seed, scenario_index, attempts)
            attempts += 1
            env = env_cls(
                config={"show_trajectories": False, "show_future_trajectories": False},
                render_mode=None,
            )
            try:
                env.reset(seed=env_seed)
                _, _, terminated, truncated, _ = env.step(int(args.group_action))
                if bool(terminated) or bool(truncated):
                    print(
                        f"[skip] checkpoint={checkpoint.name} scenario={scenario_name} "
                        f"seed={env_seed} terminated={terminated} truncated={truncated}"
                    )
                    continue

                features = _scenario_features(env, adapter)
                context, selected_mode_idx = _frozen_reward_context(model, features, env)
                noise_seed = _sample_noise_seed(args.noise_seed, scenario_index, collected)
                generator = torch.Generator(device=device.type).manual_seed(noise_seed)

                with torch.no_grad():
                    trace = sampler.sample(features, generator=generator)
                    reward_result = reward_adapter.evaluate_result(
                        trace.candidates, features=features, context=context
                    )
                    rewards = w4_to_grpo_rewards(
                        reward_result.rewards,
                        device=trace.candidates.device,
                        dtype=trace.candidates.dtype,
                    )

                sample_summary, one_group_rows, one_vm_rows = analyze_group_rewards(
                    rewards,
                    features["mode_valid_mask"],
                    candidates=trace.candidates,
                    checkpoint=checkpoint.name,
                    scenario=scenario_name,
                    sample_index=collected,
                    env_seed=env_seed,
                    noise_seed=noise_seed,
                    improvement_eps=float(args.improvement_eps),
                )
                sample_rows.append(sample_summary)
                group_rows.extend(one_group_rows)
                vm_rows.extend(one_vm_rows)
                one_selected_rows = _selected_mode_stats(
                    checkpoint=checkpoint.name,
                    scenario=scenario_name,
                    sample_index=collected,
                    env_seed=env_seed,
                    noise_seed=noise_seed,
                    noise_type=str(args.noise_type),
                    multiplicative_std=(
                        float(args.multiplicative_std)
                        if args.noise_type == "multiplicative"
                        else 0.0
                    ),
                    hybrid_multiplicative_x_std=(
                        float(args.hybrid_multiplicative_x_std)
                        if args.noise_type == "hybrid"
                        else 0.0
                    ),
                    hybrid_additive_y_std_m=(
                        float(args.hybrid_additive_y_std_m)
                        if args.noise_type == "hybrid"
                        else 0.0
                    ),
                    selected_mode_idx=selected_mode_idx,
                    candidates=trace.candidates,
                    rewards=rewards,
                )
                selected_rows.extend(one_selected_rows)
                gallery_rows.append(
                    _gallery_state(
                        checkpoint=checkpoint.name,
                        scenario=scenario_name,
                        sample_index=collected,
                        env_seed=env_seed,
                        noise_seed=noise_seed,
                        vehicle_role=int(args.gallery_vehicle_role),
                        selected_mode_idx=selected_mode_idx,
                        candidates=trace.candidates,
                        rewards=rewards,
                    )
                )

                print(
                    f"[probe] ckpt={checkpoint.name} scenario={scenario_name} "
                    f"sample={collected + 1:03d}/{args.samples_per_scenario} "
                    f"R0={sample_summary.group0_reward:.5f} "
                    f"Rbest={sample_summary.best_group_reward:.5f} "
                    f"gain={sample_summary.best_group_gain:+.5f} "
                    f"better_groups={sample_summary.better_group_count}/{args.group_size - 1} "
                    f"({sample_summary.better_group_fraction:.3f}) "
                    f"pair_better={sample_summary.pair_better_fraction:.3f} "
                    f"traj_ADE={sample_summary.element_sparse_pairwise_ade_mean:.3f}m "
                    f"vm_Rstd={sample_summary.element_reward_std_mean:.3f} "
                    f"sel_ADE={np.mean([r.sparse_pairwise_ade_mean for r in one_selected_rows]):.3f}m "
                    f"sel_dy={np.mean([r.sparse_pairwise_abs_dy_mean for r in one_selected_rows]):.3f}m "
                    f"sel_Rstd={np.mean([r.reward_std for r in one_selected_rows]):.3f} "
                    f"rank0={sample_summary.group0_rank}/{args.group_size}"
                )
                collected += 1
            finally:
                env.close()

    del sampler
    del model
    if device.type == "cuda":
        torch.cuda.empty_cache()
    return sample_rows, group_rows, vm_rows, selected_rows, gallery_rows


def _write_gallery_manifest(path: Path, rows: list[dict[str, object]]) -> None:
    if not rows:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", newline="", encoding="utf-8-sig") as file:
        writer = csv.DictWriter(file, fieldnames=list(rows[0].keys()))
        writer.writeheader()
        writer.writerows(rows)


def _plot_random_state_galleries(
    output_dir: Path,
    gallery_rows: list[GalleryState],
    *,
    visualization_seed: int,
    gallery_count: int,
    noise_label: str,
) -> None:
    try:
        import matplotlib.pyplot as plt
    except Exception as exc:
        print(f"[gallery] skipped: {exc}")
        return

    output_dir.mkdir(parents=True, exist_ok=True)
    checkpoints = list(dict.fromkeys(row.checkpoint for row in gallery_rows))
    manifest_rows: list[dict[str, object]] = []

    for checkpoint in checkpoints:
        subset = [row for row in gallery_rows if row.checkpoint == checkpoint]
        if not subset:
            continue
        n = min(int(gallery_count), len(subset))
        rng = np.random.default_rng(int(visualization_seed))
        selected_indices = sorted(rng.choice(len(subset), size=n, replace=False).tolist())
        selected = [subset[index] for index in selected_indices]

        fig, axes = plt.subplots(3, 3, figsize=(15, 12), squeeze=False)
        flat_axes = list(axes.flat)
        for ax in flat_axes:
            ax.set_visible(False)

        for slot, row in enumerate(selected):
            ax = flat_axes[slot]
            ax.set_visible(True)
            trajectories = row.trajectories
            rewards = row.rewards
            best_group = int(np.argmax(rewards))
            r0 = float(rewards[0])
            rbest = float(rewards[best_group])

            for group_id, trajectory in enumerate(trajectories):
                ax.plot(
                    trajectory[:, 0], trajectory[:, 1],
                    linewidth=0.8, alpha=0.18,
                )
            ax.plot(
                trajectories[0, :, 0], trajectories[0, :, 1],
                linewidth=2.2, marker="o", markersize=3.0,
                label=f"Group 0 (R={r0:.2f})",
            )
            ax.plot(
                trajectories[best_group, :, 0], trajectories[best_group, :, 1],
                linewidth=2.6, marker="o", markersize=3.2,
                label=f"Best g={best_group} (R={rbest:.2f})",
            )
            ax.scatter([0.0], [0.0], marker="x", s=35, label="Ego")
            ax.set_title(
                f"{row.scenario} | state={row.sample_index:02d} | v{row.vehicle_role} m{row.mode}\n"
                f"best-group gain={rbest - r0:+.3f}",
                fontsize=10,
            )
            ax.set_xlabel("x [m]")
            ax.set_ylabel("y [m]")
            ax.grid(alpha=0.2)
            ax.set_aspect("equal", adjustable="datalim")
            ax.legend(fontsize=7, loc="best")

            manifest_rows.append(
                {
                    "checkpoint": checkpoint,
                    "noise_label": noise_label,
                    "gallery_slot": slot,
                    "scenario": row.scenario,
                    "sample_index": row.sample_index,
                    "env_seed": row.env_seed,
                    "noise_seed": row.noise_seed,
                    "vehicle_role": row.vehicle_role,
                    "mode": row.mode,
                    "best_group_id": best_group,
                    "group0_reward": r0,
                    "best_reward": rbest,
                    "best_gain": rbest - r0,
                }
            )

        fig.suptitle(
            f"Random states: 48 diffusion-noise trajectory groups | {checkpoint} | {noise_label}",
            fontsize=14,
        )
        fig.tight_layout(rect=(0, 0, 1, 0.97))
        out = output_dir / f"random_noise_trajectory_gallery_3x3_{checkpoint}.png"
        fig.savefig(out, dpi=180)
        plt.close(fig)
        print(f"[gallery] {out}")

    _write_gallery_manifest(output_dir / "random_gallery_manifest.csv", manifest_rows)


def _write_outputs(
    args: argparse.Namespace,
    sample_rows: list[ProbeSampleSummary],
    group_rows: list[ProbeGroupSummary],
    vm_rows: list[ProbeVehicleModeSummary],
    selected_rows: list[SelectedModeSummary],
    gallery_rows: list[GalleryState],
) -> None:
    output_dir = args.output_dir
    output_dir.mkdir(parents=True, exist_ok=True)

    write_dataclass_csv(output_dir / "sample_summary.csv", sample_rows)
    write_dataclass_csv(output_dir / "group_summary.csv", group_rows)
    write_dataclass_csv(output_dir / "vehicle_mode_summary.csv", vm_rows)
    write_dataclass_csv(output_dir / "selected_mode_summary.csv", selected_rows)

    checkpoints = [spec.name for spec in args.checkpoint]
    summary_rows = []
    for checkpoint in checkpoints:
        summary_rows.append(
            aggregate_sample_summaries(sample_rows, checkpoint=checkpoint, scenario="all")
        )
        for scenario in _scenario_order(args):
            summary_rows.append(
                aggregate_sample_summaries(sample_rows, checkpoint=checkpoint, scenario=scenario)
            )

    for row in summary_rows:
        row["noise_type"] = str(args.noise_type)
        row["multiplicative_std"] = (
            float(args.multiplicative_std)
            if args.noise_type == "multiplicative"
            else 0.0
        )
        row["hybrid_multiplicative_x_std"] = (
            float(args.hybrid_multiplicative_x_std)
            if args.noise_type == "hybrid"
            else 0.0
        )
        row["hybrid_additive_y_std_m"] = (
            float(args.hybrid_additive_y_std_m)
            if args.noise_type == "hybrid"
            else 0.0
        )

    selected_summary_rows = []
    for checkpoint in checkpoints:
        selected_summary_rows.append(
            _aggregate_selected_mode(
                selected_rows, checkpoint=checkpoint, scenario="all"
            )
        )
        for scenario in _scenario_order(args):
            selected_summary_rows.append(
                _aggregate_selected_mode(
                    selected_rows, checkpoint=checkpoint, scenario=scenario
                )
            )

    write_dict_csv(output_dir / "overall_summary.csv", summary_rows)
    write_summary_json(output_dir / "overall_summary.json", summary_rows)
    write_dict_csv(
        output_dir / "selected_overall_summary.csv",
        selected_summary_rows,
    )

    config_payload = {
        "noise_type": str(args.noise_type),
        "multiplicative_std": (
            float(args.multiplicative_std)
            if args.noise_type == "multiplicative"
            else 0.0
        ),
        "hybrid_multiplicative_x_std": (
            float(args.hybrid_multiplicative_x_std)
            if args.noise_type == "hybrid"
            else 0.0
        ),
        "hybrid_additive_y_std_m": (
            float(args.hybrid_additive_y_std_m)
            if args.noise_type == "hybrid"
            else 0.0
        ),
        "hybrid_y_ramp": "linear_1_over_H_to_1",
        "eta": float(args.eta),
        "group_size": int(args.group_size),
        "seed": int(args.seed),
        "noise_seed": int(args.noise_seed),
        "samples_per_scenario": int(args.samples_per_scenario),
        "scenario": str(args.scenario),
    }
    with (output_dir / "probe_config.json").open("w", encoding="utf-8") as file:
        json.dump(config_payload, file, indent=2)
    if not args.no_plots:
        maybe_plot_summary(output_dir / "plots", sample_rows)
        _plot_random_state_galleries(
            output_dir / "plots",
            gallery_rows,
            visualization_seed=int(args.visualization_seed),
            gallery_count=int(args.gallery_count),
            noise_label=(
                "additive"
                if args.noise_type == "additive"
                else (
                    f"multiplicative sigma={args.multiplicative_std:g}"
                    if args.noise_type == "multiplicative"
                    else (
                        f"hybrid x-mul={args.hybrid_multiplicative_x_std:g}, "
                        f"y-add={args.hybrid_additive_y_std_m:g}m"
                    )
                )
            ),
        )

    print(f"[OK] sample CSV       : {output_dir / 'sample_summary.csv'}")
    print(f"[OK] group CSV        : {output_dir / 'group_summary.csv'}")
    print(f"[OK] vehicle-mode CSV : {output_dir / 'vehicle_mode_summary.csv'}")
    print(f"[OK] selected-mode CSV: {output_dir / 'selected_mode_summary.csv'}")
    print(f"[OK] overall summary  : {output_dir / 'overall_summary.csv'}")
    print(f"[OK] selected summary : {output_dir / 'selected_overall_summary.csv'}")
    print(f"[OK] probe config     : {output_dir / 'probe_config.json'}")

    print("\n=== OVERALL V4 ===")
    for row in summary_rows:
        if row["scenario"] != "all":
            continue
        print(
            f"{row['checkpoint']}: "
            f"traj_pair_ADE={row['mean_element_sparse_pairwise_ADE']:.3f}m | "
            f"endpoint_spread={row['mean_element_sparse_endpoint_dist']:.3f}m | "
            f"vm_Rrange={row['mean_element_reward_range']:.3f} | "
            f"vm_Rstd={row['mean_element_reward_std']:.3f} | "
            f"best-mean={row['mean_best_minus_group_mean']:+.3f} | "
            f"best-nonbest={row['mean_best_minus_nonbest_mean']:+.3f} | "
            f"ADE/Rstd corr={row['mean_element_ADE_reward_std_corr']:.3f}"
        )

    print("\n=== SELECTED-MODE V4 ===")
    for row in selected_summary_rows:
        if row["scenario"] != "all":
            continue
        print(
            f"{row['checkpoint']}: "
            f"sel_ADE={row['mean_selected_pairwise_ADE']:.3f}m | "
            f"sel_dx={row['mean_selected_pairwise_abs_dx']:.3f}m | "
            f"sel_dy={row['mean_selected_pairwise_abs_dy']:.3f}m | "
            f"end_dx_std={row['mean_selected_endpoint_dx_std']:.3f}m | "
            f"end_dy_std={row['mean_selected_endpoint_dy_std']:.3f}m | "
            f"sel_Rstd={row['mean_selected_reward_std']:.3f} | "
            f"sel_Rrange={row['mean_selected_reward_range']:.3f} | "
            f"best-mean={row['mean_selected_best_minus_mean']:+.3f}"
        )


def main() -> int:
    args = parse_args()
    if args.samples_per_scenario < 1:
        raise SystemExit("--samples-per-scenario must be >= 1")
    if args.group_size < 2:
        raise SystemExit("--group-size must be >= 2")
    if args.improvement_eps < 0:
        raise SystemExit("--improvement-eps must be >= 0")
    if args.noise_type == "multiplicative" and args.multiplicative_std <= 0:
        raise SystemExit("--multiplicative-std must be > 0 for multiplicative sampling")
    if args.noise_type == "hybrid" and args.hybrid_multiplicative_x_std <= 0:
        raise SystemExit("--hybrid-multiplicative-x-std must be > 0 for hybrid sampling")
    if args.noise_type == "hybrid" and args.hybrid_additive_y_std_m < 0:
        raise SystemExit("--hybrid-additive-y-std-m must be >= 0 for hybrid sampling")
    if args.max_seed_attempts < args.samples_per_scenario:
        raise SystemExit("--max-seed-attempts must be >= --samples-per-scenario")
    if args.gallery_count < 1:
        raise SystemExit("--gallery-count must be >= 1")

    checkpoint_names = [spec.name for spec in args.checkpoint]
    if len(checkpoint_names) != len(set(checkpoint_names)):
        raise SystemExit("checkpoint names must be unique")
    for spec in args.checkpoint:
        if not spec.path.is_file():
            raise SystemExit(f"checkpoint not found: {spec.path}")

    torch.manual_seed(int(args.seed))
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(int(args.seed))

    device = torch.device(args.device)
    print(
        f"[config] device={device} group_size={args.group_size} eta={args.eta} "
        f"noise_type={args.noise_type} mul_std={args.multiplicative_std:g} "
        f"hybrid_x_mul={args.hybrid_multiplicative_x_std:g} "
        f"hybrid_y_add_m={args.hybrid_additive_y_std_m:g} "
        f"scenario={args.scenario} samples_per_scenario={args.samples_per_scenario} "
        f"improvement_eps={args.improvement_eps:g} gallery={args.gallery_count}"
    )

    all_sample_rows: list[ProbeSampleSummary] = []
    all_group_rows: list[ProbeGroupSummary] = []
    all_vm_rows: list[ProbeVehicleModeSummary] = []
    all_selected_rows: list[SelectedModeSummary] = []
    all_gallery_rows: list[GalleryState] = []

    for checkpoint in args.checkpoint:
        sample_rows, group_rows, vm_rows, selected_rows, gallery_rows = _run_checkpoint(
            args, checkpoint, device=device
        )
        all_sample_rows.extend(sample_rows)
        all_group_rows.extend(group_rows)
        all_vm_rows.extend(vm_rows)
        all_selected_rows.extend(selected_rows)
        all_gallery_rows.extend(gallery_rows)

    _write_outputs(
        args,
        all_sample_rows,
        all_group_rows,
        all_vm_rows,
        all_selected_rows,
        all_gallery_rows,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
